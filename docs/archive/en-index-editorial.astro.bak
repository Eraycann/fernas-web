---
import Base from "../../layouts/Base.astro";
import sectors from "../../data/sectors.json";
import stats from "../../data/stats.json";
import { loadProjects } from "../../lib/projects";
import { loadNews } from "../../lib/news";

const sectorCopy: Record<
  string,
  { name: string; description: string; metric: string }
> = {
  insaat: {
    name: "Construction",
    description: "Engineering, construction and operation across roads, bridges, tunnels and infrastructure.",
    metric: "Since 1982",
  },
  enerji: {
    name: "Energy",
    description: "Installed and operating capacity across hydroelectric, wind and solar power plants.",
    metric: "570 MW",
  },
  "dogalgaz-dagitim": {
    name: "Gas Distribution",
    description: "Natural gas distribution and subscriber services in Diyarbakır since 2006.",
    metric: "1.5M people",
  },
  sanayi: {
    name: "Industry",
    description: "Industrial production and investment in Aksaray, Ankara and Batman.",
    metric: "14 facilities",
  },
  gida: {
    name: "Food",
    description: "Agricultural and food production, processing and cold storage since 2015.",
    metric: "Since 2015",
  },
  turizm: {
    name: "Tourism",
    description: "Hospitality and tourism operations on the Aegean coast with Cape Bodrum.",
    metric: "Cape Bodrum",
  },
};

const statLabels = [
  "Installed capacity",
  "In operation",
  "Facilities",
  "Population served",
  "Projects",
];

const allProjects = loadProjects();
const featured = allProjects.filter((project) => project.featured);
const projectSelection = (featured.length >= 6 ? featured : allProjects).slice(0, 6);
const news = loadNews().slice(0, 3);

const formatDate = (value: string) =>
  value
    ? new Date(`${value.slice(0, 10)}T12:00:00`).toLocaleDateString("en-GB", {
        day: "2-digit",
        month: "long",
        year: "numeric",
      })
    : "";

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Fernas Group",
  url: "https://www.fernas.com.tr/en/",
  inLanguage: "en-US",
};
---

<Base
  title="Fernas Group — One group, six disciplines"
  description="Since 1982: construction, energy, gas distribution, industry, food and tourism. 570 MW installed capacity, 14 facilities, more than 60 projects."
  lang="en"
  trPath="/"
  enPath="/en/"
  jsonLd={websiteLd}
>
  <section class="hero" id="sectors">
    <div class="shell hero-intro">
      <div>
        <p class="eyebrow">Since 1982 · Ankara</p>
        <h1 class="hero-title">
          One group.
          <em>Six disciplines.</em>
        </h1>
      </div>

      <div class="hero-copy">
        <p class="hero-lede">
          From construction and energy to gas distribution and food, Fernas is a
          group built on measurable work and long-term operating discipline.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/en/projects/">View projects</a>
          <a class="btn btn-ghost" href="/en/about/">About the group</a>
        </div>
        <div class="hero-meta">
          <div>
            <strong>570 MW</strong>
            <span>installed capacity</span>
          </div>
          <div>
            <strong>14</strong>
            <span>facilities</span>
          </div>
          <div>
            <strong>60+</strong>
            <span>projects</span>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-slats" aria-label="Business areas">
      {sectors.map((sector) => {
        const copy = sectorCopy[sector.slug];
        return (
          <a
            class="hero-slat"
            href={`/en/projects/?sector=${sector.slug}`}
            style={`--slat-image:url(/images/sectors/${sector.slug}.webp);--slat-tint:${sector.tint}`}
          >
            <div class="hero-slat__media" aria-hidden="true"></div>
            <div class="hero-slat__inner">
              <span class="hero-slat__num">{copy.metric}</span>
              <div class="hero-slat__bottom">
                <span class="hero-slat__label">{copy.name}</span>
                <p class="hero-slat__desc">{copy.description}</p>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="measure-band" aria-label="Group measurements">
    <div class="shell">
      <div class="measure-grid">
        {stats.map((stat, index) => (
          <div class="measure-item">
            <strong>
              {stat.value}
              {stat.unit && <span>{stat.unit}</span>}
            </strong>
            <small>{statLabels[index] ?? stat.label}</small>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow">The group</p>
        <h2 class="section-title mt-5">Measurable work. Long-term partnership.</h2>
      </div>
      <div class="lg:col-span-5 lg:pt-16">
        <p class="section-lede">
          The measure of a group is how long the work it builds stands. Fernas
          keeps engineering, construction and operating responsibility on the
          same line.
        </p>
        <div class="mt-8 grid gap-0 border-t border-steel/30">
          {[
            ["Long-term view", "Building an asset is only part of the work; operating it is the group's business too."],
            ["Engineering discipline", "Every project closes with measurement, field work and commissioning."],
            ["Operating responsibility", "Facilities serve their regions for many years after construction."],
          ].map(([title, body]) => (
            <div class="border-b border-steel/30 py-5">
              <div>
                <h3 class="font-display text-[1.05rem] font-semibold tracking-[-0.02em]">{title}</h3>
                <p class="mt-1 text-[0.88rem] leading-relaxed text-ink/65">{body}</p>
              </div>
            </div>
          ))}
        </div>
        <a class="link-underline mt-8" href="/en/about/">About Fernas</a>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected projects</p>
          <h2 class="section-title mt-5">From the field.</h2>
        </div>
        <a class="link-underline" href="/en/projects/">All projects</a>
      </div>

      <div class="grid gap-px bg-steel/25 sm:grid-cols-2 lg:grid-cols-3">
        {projectSelection.map((project) => (
          <a
            class="group flex flex-col bg-white p-4 transition-colors hover:bg-chalk"
            href={`/en/projects/${project.slug}/`}
          >
            {project.cover && (
              <div class="overflow-hidden bg-ink">
                <img
                  src={project.cover}
                  alt={`${project.titleEn || project.title} — Fernas`}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </div>
            )}
            <div class="mt-5 flex items-start justify-between gap-4">
              <div>
                <p class="mono text-[0.62rem] text-steel">
                  {[project.sectorEn, project.city, project.year].filter(Boolean).join(" · ")}
                </p>
                <h3 class="mt-3 font-display text-[1.25rem] font-semibold leading-[1.08] tracking-[-0.03em] group-hover:text-blue">
                  {project.titleEn || project.title}
                </h3>
              </div>
              <span class="pt-1 text-blue" aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-ink text-white">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <p class="eyebrow text-white/75">Sustainability</p>
        <h2 class="section-title mt-5 text-white">All of our energy is renewable.</h2>
        <p class="mt-6 max-w-lg text-[1rem] leading-relaxed text-white/70">
          All 570 MW of installed capacity comes from renewable sources. 485 MW
          is in operation, with production, environmental impact and operating
          efficiency tracked together.
        </p>
        <a class="link-underline mt-8 text-white" href="/en/sustainability/">Sustainability</a>
      </div>

      <div class="lg:col-span-6">
        <div class="border border-white/20 p-6 sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <span class="mono text-[0.62rem] text-white/70">INSTALLED CAPACITY / TOTAL</span>
            <span class="mono text-[0.62rem] text-white/70">TR · 2026</span>
          </div>
          <div class="mt-6 font-display text-[clamp(4.5rem,10vw,9rem)] font-semibold leading-[0.8] tracking-[-0.07em]">
            570<span class="ml-2 align-top text-[0.24em] tracking-normal text-amber">MW</span>
          </div>
          <div class="mt-8 grid grid-cols-2 gap-4 border-t border-white/20 pt-4">
            <div>
              <p class="mono text-[0.6rem] text-white/70">IN OPERATION</p>
              <p class="mt-1 font-display text-[1.7rem] font-semibold tracking-[-0.03em]">485 MW</p>
            </div>
            <div>
              <p class="mono text-[0.6rem] text-white/70">SOURCE</p>
              <p class="mt-1 font-display text-[1.7rem] font-semibold tracking-[-0.03em]">100% renewable</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow">News</p>
          <h2 class="section-title mt-5">From the archive.</h2>
        </div>
        <a class="link-underline" href="/en/news/">All news</a>
      </div>

      <div class="news-grid">
        {news.map((item) => (
          <a class="news-card" href={`/en/news/${item.slug}/`}>
            <span class="news-card__date">{formatDate(item.publishedAt)} · {item.category}</span>
            <h3 class="news-card__title">{item.titleEn || item.title}</h3>
            <p class="news-card__excerpt">{item.excerptEn || item.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-blue text-white">
    <div class="shell flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow text-white/75">Contact</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(2.4rem,5vw,5rem)] font-semibold leading-[0.94] tracking-[-0.05em]">
          For the next project.
        </h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-light" href="/en/contact/">Get in touch</a>
        <a class="btn btn-light" href="/en/career/">Careers</a>
      </div>
    </div>
  </section>
</Base>
