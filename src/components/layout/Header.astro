---
import Logo from "../ui/Logo.astro";
import site from "../../data/site.json";

interface Props {
  lang?: "tr" | "en";
}

const { lang = "tr" } = Astro.props;
const isEn = lang === "en";

const t = isEn
  ? {
      navLabel: "Main menu",
      corporate: "Company",
      about: "About",
      sectors: "Sectors",
      projects: "Projects",
      sustainability: "Sustainability",
      news: "News",
      career: "Career",
      contact: "Contact",
      language: "Language selection",
      menu: "Menu",
      openMenu: "Open menu",
      more: "More",
      search: "Search",
      mobileNav: "Mobile menu",
      home: "Fernas Group home page",
      location: "Ankara · Türkiye",
    }
  : {
      navLabel: "Ana menü",
      corporate: "Kurumsal",
      about: "Hakkımızda",
      sectors: "Sektörler",
      projects: "Projeler",
      sustainability: "Sürdürülebilirlik",
      news: "Haberler",
      career: "Kariyer",
      contact: "İletişim",
      language: "Dil seçimi",
      menu: "Menü",
      openMenu: "Menüyü aç",
      more: "Daha fazla",
      search: "Arama",
      mobileNav: "Mobil menü",
      home: "Fernas Şirketler Grubu ana sayfa",
      location: "Ankara · Türkiye",
    };

const homeHref = isEn ? "/en/" : "/";
const aboutHref = isEn ? "/en/about/" : "/grup/hakkimizda/";
const projectsHref = isEn ? "/en/projects/" : "/projeler/";
const sustainabilityHref = isEn ? "/en/sustainability/" : "/surdurulebilirlik/";
const newsHref = isEn ? "/en/news/" : "/haberler/";
const careerHref = isEn ? "/en/career/" : "/kariyer/";
const contactHref = isEn ? "/en/contact/" : "/iletisim/";
const searchHref = isEn ? "/en/search/" : "/arama/";

const sectorLinks = [
  { slug: "insaat", tr: "İnşaat", en: "Construction" },
  { slug: "enerji", tr: "Enerji", en: "Energy" },
  { slug: "dogalgaz-dagitim", tr: "Doğalgaz dağıtımı", en: "Gas distribution" },
  { slug: "sanayi", tr: "Sanayi", en: "Industry" },
  { slug: "gida", tr: "Gıda", en: "Food" },
  { slug: "turizm", tr: "Turizm", en: "Tourism" },
];

const sectorHref = (slug: string) =>
  isEn ? `/en/projects/?sector=${slug}` : `/sektorler/${slug}/`;

const corporateLinks = isEn
  ? [
      { href: aboutHref, label: t.about },
      { href: "/en/policies/", label: "Policies" },
      { href: "/en/privacy/", label: "Privacy" },
    ]
  : [
      { href: aboutHref, label: t.about },
      { href: "/grup/tarihce/", label: "Tarihçe" },
      { href: "/grup/uyelikler/", label: "Üyelikler" },
      { href: "/grup/kalite-belgeleri/", label: "Kalite belgeleri" },
      { href: "/grup/politikalar/", label: "Politikalar" },
      { href: "/grup/bilgi-toplumu/", label: "Bilgi toplumu" },
    ];
---

<div class="utility-bar">
  <div class="shell utility-inner">
    <div class="utility-meta">
      <span>{t.location}</span>
      <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
    </div>
    <div class="utility-links">
      <a href={newsHref}>{t.news}</a>
      <a href={careerHref}>{t.career}</a>
      <a href={contactHref}>{t.contact}</a>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="shell header-inner">
    <Logo href={homeHref} />

    <nav class="desktop-nav" aria-label={t.navLabel}>
      <div class="nav-item has-menu">
        <a class="nav-link" href={aboutHref}>{t.corporate}</a>
        <div class="nav-menu">
          {corporateLinks.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>

      <div class="nav-item has-menu">
        <a class="nav-link" href={isEn ? "/en/#sectors" : "/#sektorler"}>{t.sectors}</a>
        <div class="nav-menu">
          {sectorLinks.map((sector) => (
            <a href={sectorHref(sector.slug)}>{isEn ? sector.en : sector.tr}</a>
          ))}
        </div>
      </div>

      <a class="nav-link" href={projectsHref}>{t.projects}</a>
      <a class="nav-link" href={sustainabilityHref}>{t.sustainability}</a>
      <a class="nav-link" href={newsHref}>{t.news}</a>
      <a class="nav-link" href={careerHref}>{t.career}</a>
    </nav>

    <div class="header-actions">
      <a class="header-search" href={searchHref} aria-label={t.search}>
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <circle cx="6.5" cy="6.5" r="4.75" stroke="currentColor" stroke-width="1.2" />
          <path d="m10.2 10.2 3.3 3.3" stroke="currentColor" stroke-width="1.2" />
        </svg>
      </a>

      <div class="lang-switch" aria-label={t.language}>
        <a href="/" aria-current={!isEn ? "true" : undefined}>TR</a>
        <span aria-hidden="true">/</span>
        <a href="/en/" aria-current={isEn ? "true" : undefined}>EN</a>
      </div>

      <a class="btn btn-primary header-cta" href={contactHref}>{t.contact}</a>

      <details class="mobile-menu">
        <summary aria-label={t.openMenu}>
          <span>{t.menu}</span>
          <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
            <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </summary>
        <div class="mobile-panel">
          <nav aria-label={t.mobileNav}>
            <p class="mobile-heading">{t.corporate}</p>
            {corporateLinks.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
            <a href={sustainabilityHref}>{t.sustainability}</a>

            <p class="mobile-heading">{t.sectors}</p>
            {sectorLinks.map((sector) => (
              <a href={sectorHref(sector.slug)}>{isEn ? sector.en : sector.tr}</a>
            ))}

            <p class="mobile-heading">{t.more}</p>
            <a href={projectsHref}>{t.projects}</a>
            <a href={newsHref}>{t.news}</a>
            <a href={careerHref}>{t.career}</a>
            <a href={searchHref}>{t.search}</a>
            <a href={contactHref}>{t.contact}</a>
          </nav>
          <div class="mobile-lang">
            <a href="/" aria-current={!isEn ? "true" : undefined}>Türkçe</a>
            <a href="/en/" aria-current={isEn ? "true" : undefined}>English</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .utility-bar {
    background: var(--color-ink);
    color: color-mix(in srgb, var(--color-white) 72%, transparent);
  }

  .utility-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 2.4rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .utility-meta,
  .utility-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .utility-bar a {
    transition: color 160ms ease;
  }

  .utility-bar a:hover {
    color: var(--color-white);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-white) 96%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-steel) 18%, transparent);
    box-shadow: 0 1px 0 rgba(6, 21, 34, 0.03);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 4.75rem;
  }

  .header-inner :global(.logo-mark) {
    width: 2.05rem;
    height: 2.05rem;
  }

  .header-inner :global(.logo-type strong) {
    font-size: 1.14rem;
  }

  .header-inner :global(.logo-type small) {
    font-size: 0.5rem;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.95rem, 1.65vw, 1.7rem);
    margin-inline-start: auto;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    font-size: 0.84rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--color-ink) 84%, var(--color-steel));
    transition: color 160ms ease;
  }

  .has-menu > .nav-link::after {
    content: "";
    width: 0.34rem;
    height: 0.34rem;
    margin-inline-start: 0.38rem;
    border-inline-end: 1.4px solid currentColor;
    border-block-end: 1.4px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    opacity: 0.55;
  }

  .nav-link:hover {
    color: var(--color-blue);
  }

  .nav-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: -1rem;
    min-width: 15.5rem;
    padding: 0.6rem;
    background: var(--color-white);
    border: 1px solid color-mix(in srgb, var(--color-steel) 22%, transparent);
    box-shadow: 0 18px 50px rgba(6, 21, 34, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.35rem);
    transition: opacity 160ms ease, transform 160ms ease, visibility 160ms;
  }

  .nav-menu::before {
    content: "";
    position: absolute;
    top: -0.7rem;
    inset-inline: 0;
    height: 0.7rem;
  }

  .nav-menu a {
    display: block;
    padding: 0.55rem 0.65rem;
    font-size: 0.8rem;
    line-height: 1.35;
    color: color-mix(in srgb, var(--color-ink) 78%, var(--color-steel));
    transition: background 140ms ease, color 140ms ease;
  }

  .nav-menu a:hover {
    background: color-mix(in srgb, var(--color-blue) 7%, transparent);
    color: var(--color-blue);
  }

  .has-menu:hover .nav-menu,
  .has-menu:focus-within .nav-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-search {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    color: color-mix(in srgb, var(--color-ink) 70%, var(--color-steel));
    transition: color 160ms ease, background 160ms ease;
  }

  .header-search:hover {
    color: var(--color-blue);
    background: color-mix(in srgb, var(--color-blue) 7%, transparent);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-steel);
  }

  .lang-switch a[aria-current="true"] {
    color: var(--color-ink);
    font-weight: 500;
  }

  .lang-switch a:hover {
    color: var(--color-blue);
  }

  .header-cta {
    min-height: 2.6rem;
    padding: 0.68rem 1.05rem;
    font-size: 0.82rem;
  }

  .mobile-menu {
    display: none;
    position: static;
  }

  .mobile-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.4rem;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-panel {
    position: fixed;
    inset-inline: 0;
    top: 4rem;
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    padding: 1rem var(--spacing-gutter) 2rem;
    background: var(--color-white);
    border-top: 1px solid color-mix(in srgb, var(--color-steel) 18%, transparent);
    box-shadow: 0 30px 60px rgba(6, 21, 34, 0.12);
  }

  .mobile-menu:not([open]) .mobile-panel {
    display: none;
  }

  .mobile-panel nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-panel nav a {
    padding: 0.62rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-steel) 18%, transparent);
    font-size: 0.95rem;
  }

  .mobile-heading {
    margin: 1.25rem 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: var(--color-steel);
  }

  .mobile-heading:first-child {
    margin-top: 0;
  }

  .mobile-lang {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .mobile-lang a[aria-current="true"] {
    color: var(--color-blue);
    font-weight: 500;
  }

  @media (max-width: 1120px) {
    .utility-bar,
    .desktop-nav,
    .header-cta {
      display: none;
    }
    .header-inner {
      min-height: 4rem;
    }
    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .lang-switch {
      display: none;
    }
  }
</style>
