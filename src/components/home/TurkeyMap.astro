---
const nodes = [
  { name: "Ankara", x: 43, y: 47, hub: true },
  { name: "Diyarbakır", x: 72, y: 64 },
  { name: "Aksaray", x: 47, y: 57 },
  { name: "Batman", x: 75, y: 66 },
  { name: "Bodrum", x: 20, y: 72 },
  { name: "İstanbul", x: 25, y: 35 },
  { name: "Çorum", x: 55, y: 38 },
  { name: "Balıkesir", x: 28, y: 47 },
  { name: "Hatay", x: 65, y: 82 },
  { name: "Sinop", x: 52, y: 22 },
];
---

<div
  class="turkey-map"
  role="img"
  aria-label="Fernas faaliyetlerinin şematik Türkiye haritası. Ankara merkez; Diyarbakır, Aksaray, Batman, Bodrum, İstanbul, Çorum, Balıkesir, Hatay ve Sinop'ta projeler."
>
  <div class="map-fill" aria-hidden="true"></div>
  <div class="map-dots" aria-hidden="true"></div>

  <svg class="map-arcs" viewBox="0 0 1000 440" fill="none" aria-hidden="true">
    <path d="M430 207 Q 560 140 720 282" />
    <path d="M430 207 Q 450 220 470 251" />
    <path d="M430 207 Q 590 200 750 290" />
    <path d="M430 207 Q 300 240 200 317" />
    <path d="M430 207 Q 330 140 250 154" />
    <path d="M430 207 Q 500 170 550 167" />
    <path d="M430 207 Q 340 200 280 207" />
    <path d="M430 207 Q 550 320 650 361" />
    <path d="M430 207 Q 480 120 520 97" />
  </svg>

  {nodes.map((node) => (
    <span
      class:list={["map-node", node.hub && "map-node--hub"]}
      style={`left:${node.x}%;top:${node.y}%`}
    >
      <i aria-hidden="true"></i>
      <b>{node.name}</b>
    </span>
  ))}

  <span class="map-note">Şematik gösterim · ölçekli değildir</span>
</div>

<style>
  .turkey-map {
    position: relative;
    aspect-ratio: 1600 / 706;
    width: 100%;
    min-height: 16rem;
  }

  .map-fill,
  .map-dots {
    position: absolute;
    inset: 0;
    -webkit-mask-image: url("/images/tr-mask.png");
    mask-image: url("/images/tr-mask.png");
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .map-fill {
    background: color-mix(in srgb, var(--color-white) 8%, transparent);
  }

  .map-dots {
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.62) 1px, transparent 1.5px);
    background-size: 7px 7px;
  }

  .map-arcs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .map-arcs path {
    stroke: rgba(224, 138, 43, 0.62);
    stroke-width: 1.2;
    stroke-dasharray: 3 5;
    vector-effect: non-scaling-stroke;
  }

  .map-node {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.86);
  }

  .map-node i {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-amber);
    box-shadow: 0 0 0 3px rgba(224, 138, 43, 0.16);
  }

  .map-node b {
    font-weight: 400;
    transform: translateY(-1px);
  }

  .map-node--hub {
    font-size: 0.7rem;
    color: var(--color-white);
  }

  .map-node--hub i {
    width: 9px;
    height: 9px;
    box-shadow:
      0 0 0 4px rgba(224, 138, 43, 0.18),
      0 0 0 9px rgba(224, 138, 43, 0.06);
  }

  .map-note {
    position: absolute;
    right: 0;
    bottom: 0;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 640px) {
    .map-node b {
      display: none;
    }
    .map-node--hub b {
      display: inline;
    }
    .turkey-map {
      min-height: 14rem;
    }
  }
</style>
