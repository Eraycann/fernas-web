---
import Base from "../../layouts/Base.astro";
import VideoFacade from "../../components/ui/VideoFacade.astro";
import { loadProjects } from "../../lib/projects";

export function getStaticPaths() {
  return loadProjects().map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const statusLabels: Record<string, string> = {
  tamamlandi: "Tamamlandı",
  "devam-ediyor": "Devam ediyor",
  isletmede: "İşletmede",
  planlama: "Planlama",
};

const status = statusLabels[project.status] ?? project.status;
const bodyHtml = project.bodyHtml
  .replace(/<script[\s\S]*?<\/script>/gi, "")
  .replace(/<style[\s\S]*?<\/style>/gi, "");

const facts = [
  ["Sektör", project.sector],
  ["Şehir", project.city],
  ["Ülke", project.country],
  ["Yıl", project.year],
  ["Kapasite", project.capacity],
  ["İşveren", project.client],
  ["Durum", status],
].filter(([, value]) => Boolean(value));

const all = loadProjects();
const currentIndex = all.findIndex((item) => item.slug === project.slug);
const next = all[(currentIndex + 1) % all.length];
const previous = all[(currentIndex - 1 + all.length) % all.length];
const related = all
  .filter((item) => item.slug !== project.slug && item.sectorSlug === project.sectorSlug)
  .slice(0, 3);

const image800 = (src: string) => src.replace(/cover-1600\.webp$/, "cover-800.webp");

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Ana sayfa",
      item: "https://www.fernas.com.tr/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Projeler",
      item: "https://www.fernas.com.tr/projeler/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: project.title,
      item: `https://www.fernas.com.tr/projeler/${project.slug}/`,
    },
  ],
};
---

<Base
  title={`${project.title} — Fernas Şirketler Grubu`}
  description={`${project.title}. ${[project.sector, project.city, project.year].filter(Boolean).join(" · ")}.`}
  image={project.cover || undefined}
  jsonLd={breadcrumbLd}
>
  <div class="shell">
    <nav
      class="mono flex flex-wrap items-center gap-2 pt-6 text-[0.64rem] text-steel"
      aria-label="Breadcrumb"
    >
      <a class="hover:text-blue" href="/">Ana sayfa</a>
      <span aria-hidden="true">/</span>
      <a class="hover:text-blue" href="/projeler/">Projeler</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink">{project.title}</span>
    </nav>
  </div>

  {project.cover && (
    <figure class="project-cover mt-6">
      <img
        src={project.cover}
        srcset={`${image800(project.cover)} 800w, ${project.cover} 1600w`}
        sizes="100vw"
        alt={project.alt}
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  )}

  <section class="section">
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-8">
          <p class="eyebrow">{[project.sector, status].filter(Boolean).join(" · ")}</p>
          <h1 class="mt-5 max-w-[20ch] font-display text-[clamp(2.4rem,4.4vw,4.6rem)] font-semibold leading-[0.9] tracking-[-0.055em]">
            {project.title}
          </h1>

          <dl class="mt-8 grid grid-cols-2 gap-y-4 border-y border-steel/30 py-5 sm:grid-cols-4">
            {[
              ["Şehir", project.city],
              ["Ülke", project.country],
              ["Yıl", project.year],
              ["Kapasite", project.capacity],
            ]
              .filter(([, value]) => Boolean(value))
              .map(([label, value]) => (
                <div>
                  <dt class="mono text-[0.6rem] text-steel">{label}</dt>
                  <dd class="mt-1 text-[0.92rem]">{value}</dd>
                </div>
              ))}
          </dl>

          <div class="mt-10">
            {bodyHtml ? (
              <div class="prose-fernas" set:html={bodyHtml} />
            ) : project.scope ? (
              <div>
                <p class="mt-4 max-w-2xl text-[1.05rem] leading-relaxed text-ink/75">
                  {project.scope}
                </p>
              </div>
            ) : (
              <div class="max-w-xl border-l-2 border-amber pl-5">
                <p class="text-[0.98rem] leading-relaxed text-ink/70">
                  Bu proje kaydı arşivde tutuluyor. Kapsam, saha ve teknik
                  bilgiler için iletişim formunu kullanabilirsiniz.
                </p>
                <a class="link-underline mt-4" href="/iletisim/">Bilgi talep et</a>
              </div>
            )}
          </div>

          {project.video && project.videoPoster && (
            <div class="mt-12">
              <VideoFacade
                src={project.video}
                poster={project.videoPoster}
                title={project.title}
                caption={`${project.title} — saha görüntüsü`}
              />
            </div>
          )}

          {project.gallery.length > 0 && (
            <div class="mt-12">
              <h2 class="font-display text-[1.4rem] font-semibold tracking-[-0.03em]">Galeri</h2>
              <div class="mt-5 grid gap-1 sm:grid-cols-2">
                {project.gallery.map((image, index) => (
                  <figure class="overflow-hidden bg-ink">
                    <img
                      src={image}
                      alt={`${project.title} — görsel ${index + 1}`}
                      width="1200"
                      height="800"
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/3] w-full object-cover"
                    />
                  </figure>
                ))}
              </div>
            </div>
          )}
        </div>

        <aside class="lg:col-span-4">
          <div class="sticky top-24">
            <div class="border border-steel/30">
              <div class="border-b border-steel/30 px-5 py-4">
                <h2 class="mono text-[0.62rem] text-steel">Künye</h2>
              </div>
              <dl>
                {facts.map(([label, value]) => (
                  <div class="grid grid-cols-[6.5rem_1fr] gap-3 border-b border-steel/20 px-5 py-3 last:border-b-0">
                    <dt class="mono text-[0.62rem] text-steel">{label}</dt>
                    <dd class="text-[0.86rem] leading-relaxed">{value}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="mt-6 border border-steel/30 p-5">
              <h2 class="mono text-[0.62rem] text-steel">Paylaş</h2>
              <div class="mt-3 flex flex-wrap gap-3 text-[0.8rem]">
                <a
                  class="link-underline"
                  href={`mailto:?subject=${encodeURIComponent(project.title)}&body=${encodeURIComponent(`https://www.fernas.com.tr/projeler/${project.slug}/`)}`}
                >
                  E-posta
                </a>
                <a
                  class="link-underline"
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://www.fernas.com.tr/projeler/${project.slug}/`)}`}
                  target="_blank"
                  rel="noreferrer"
                >
                  LinkedIn
                </a>
              </div>
            </div>

            {project.sourceUrl && (
              <p class="mono mt-4 text-[0.6rem] leading-relaxed text-steel">
                Kaynak:{" "}
                <a
                  class="underline decoration-steel/40 underline-offset-2 hover:text-blue"
                  href={project.sourceUrl}
                  target="_blank"
                  rel="noreferrer"
                >
                  fernas.com.tr
                </a>
              </p>
            )}
          </div>
        </aside>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section bg-white">
      <div class="shell">
        <div class="home-head">
          <div>
            <h2>Aynı sektörden.</h2>
          </div>
          <a class="home-link" href="/projeler/">Tüm projeler</a>
        </div>

        <div class="project-grid">
          {related.map((item) => (
            <a class="project-card" href={`/projeler/${item.slug}/`}>
              {item.cover && (
                <div class="project-card__media">
                  <img
                    src={image800(item.cover)}
                    srcset={`${image800(item.cover)} 800w, ${item.cover} 1600w`}
                    sizes="(max-width: 767px) 100vw, (max-width: 900px) 45vw, 28rem"
                    alt={item.alt}
                    width="800"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="project-card__plate">
                <p class="project-card__meta">
                  {[item.city, item.year, item.capacity].filter(Boolean).join(" · ")}
                </p>
                <h3>{item.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="shell grid gap-4 sm:grid-cols-2">
      <a class="group border border-steel/30 p-6 transition-colors hover:border-blue" href={`/projeler/${previous.slug}/`}>
        <p class="mono text-[0.62rem] text-steel">Önceki kayıt</p>
        <p class="mt-4 font-display text-[1.35rem] font-semibold leading-[1.05] tracking-[-0.03em] group-hover:text-blue">
          {previous.title}
        </p>
      </a>
      <a class="group border border-steel/30 p-6 text-right transition-colors hover:border-blue" href={`/projeler/${next.slug}/`}>
        <p class="mono text-[0.62rem] text-steel">Sonraki kayıt</p>
        <p class="mt-4 font-display text-[1.35rem] font-semibold leading-[1.05] tracking-[-0.03em] group-hover:text-blue">
          {next.title}
        </p>
      </a>
    </div>
  </section>
</Base>
