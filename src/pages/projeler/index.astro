---
import Base from "../../layouts/Base.astro";
import ProjectArchive from "../../components/projects/ProjectArchive";
import { loadProjects, toProjectSummary } from "../../lib/projects";

const allProjects = loadProjects();
const projects = allProjects.map(toProjectSummary);
const sectorCount = new Set(allProjects.map((project) => project.sector)).size;
const countryCount = new Set(allProjects.map((project) => project.country).filter(Boolean)).size;
---

<Base
  title="Projeler — Fernas Şirketler Grubu"
  description="Fernas proje arşivi: inşaat, enerji, doğalgaz dağıtımı, sanayi, gıda ve turizm alanlarında tamamlanan ve devam eden projeler."
>
  <section class="section">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-8">
        <p class="eyebrow">Projeler</p>
        <h1 class="mt-5 max-w-[14ch] font-display text-[clamp(2.8rem,5vw,5rem)] font-semibold leading-[0.86] tracking-[-0.06em]">
          Proje arşivi.
        </h1>
      </div>
      <div class="lg:col-span-4 lg:pt-16">
        <p class="section-lede">
          İnşaat sahalarından enerji santrallerine, dağıtım ağından üretim
          tesislerine. Sektöre, şehre veya yıla göre filtreleyin.
        </p>
        <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-steel/30 pt-5">
          <div>
            <dt class="mono text-[0.6rem] text-steel">KAYIT</dt>
            <dd class="mt-1 font-display text-[1.5rem] font-semibold tracking-[-0.03em]">{allProjects.length}</dd>
          </div>
          <div>
            <dt class="mono text-[0.6rem] text-steel">SEKTÖR</dt>
            <dd class="mt-1 font-display text-[1.5rem] font-semibold tracking-[-0.03em]">{sectorCount}</dd>
          </div>
          <div>
            <dt class="mono text-[0.6rem] text-steel">ÜLKE</dt>
            <dd class="mt-1 font-display text-[1.5rem] font-semibold tracking-[-0.03em]">{countryCount}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--tight rule">
    <div class="shell">
      <ProjectArchive projects={projects} client:load />
    </div>
  </section>

  <section class="section bg-ink text-white">
    <div class="shell flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow text-white/75">Arşiv</p>
        <h2 class="mt-5 max-w-[15ch] font-display text-[clamp(2rem,3.6vw,3.6rem)] font-semibold leading-[0.94] tracking-[-0.05em]">
          Bir proje mi arıyorsunuz?
        </h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-light" href="/iletisim/">İletişime geç</a>
        <a class="btn btn-light" href="/sektorler/insaat/">Sektörler</a>
      </div>
    </div>
  </section>
</Base>
