---
import Base from "../../layouts/Base.astro";
import { loadNews } from "../../lib/news";

export function getStaticPaths() {
  return loadNews().map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const news = loadNews();
const index = news.findIndex((entry) => entry.slug === item.slug);
const next = news[(index + 1) % news.length];
const previous = news[(index - 1 + news.length) % news.length];

const formatDate = (value: string) =>
  value
    ? new Date(`${value.slice(0, 10)}T12:00:00`).toLocaleDateString("tr-TR", {
        day: "2-digit",
        month: "long",
        year: "numeric",
      })
    : "";

const bodyHtml = item.bodyHtml
  .replace(/<script[\s\S]*?<\/script>/gi, "")
  .replace(/<style[\s\S]*?<\/style>/gi, "");

const articleLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: item.title,
  description: item.excerpt,
  datePublished: item.publishedAt,
  dateModified: item.publishedAt,
  inLanguage: "tr-TR",
  image: item.cover ? [`https://www.fernas.com.tr${item.cover}`] : undefined,
  mainEntityOfPage: `https://www.fernas.com.tr/haberler/${item.slug}/`,
  publisher: {
    "@type": "Organization",
    name: "Fernas Şirketler Grubu",
    logo: {
      "@type": "ImageObject",
      url: "https://www.fernas.com.tr/favicon.svg",
    },
  },
};
---

<Base
  title={`${item.title} — Fernas Şirketler Grubu`}
  description={item.excerpt || item.title}
  image={item.cover || undefined}
  type="article"
  jsonLd={articleLd}
>
  <article>
    <section class="section">
      <div class="shell">
        <nav class="mono flex flex-wrap items-center gap-2 text-[0.64rem] text-steel" aria-label="Breadcrumb">
          <a class="hover:text-blue" href="/">Ana sayfa</a>
          <span aria-hidden="true">/</span>
          <a class="hover:text-blue" href="/haberler/">Haberler</a>
          <span aria-hidden="true">/</span>
          <span class="text-ink">{item.title}</span>
        </nav>

        <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-8">
            <p class="mono text-[0.64rem] text-steel">
              {formatDate(item.publishedAt)} · {item.category}
            </p>
            <h1 class="mt-5 max-w-[20ch] font-display text-[clamp(2.2rem,4vw,4rem)] font-semibold leading-[0.94] tracking-[-0.05em]">
              {item.title}
            </h1>
            {item.excerpt && (
              <p class="mt-6 max-w-2xl text-[1.05rem] leading-relaxed text-ink/65">{item.excerpt}</p>
            )}
          </div>

          <div class="lg:col-span-4">
            {item.cover ? (
              <figure class="sector-figure">
                <img
                  src={item.cover}
                  alt={item.title}
                  width="1600"
                  height="1000"
                  loading="eager"
                  decoding="async"
                />
                <figcaption class="mono">FERNAS / HABER</figcaption>
              </figure>
            ) : (
              <div class="sector-placeholder" style="--sector-tint:#045091">
                <span class="mono relative z-10 text-[0.62rem] text-white/75">FERNAS / HABER</span>
                <strong class="relative z-10">{item.category}</strong>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="section rule">
      <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-8">
          {bodyHtml ? (
            <div class="prose-fernas" set:html={bodyHtml} />
          ) : (
            <p class="max-w-xl text-[0.98rem] leading-relaxed text-ink/70">
              Bu haberin metni arşivde tutuluyor. Ayrıntılı bilgi için iletişim
              formunu kullanabilirsiniz.
            </p>
          )}

          {item.sourceUrl && (
            <p class="mono mt-10 text-[0.62rem] leading-relaxed text-steel">
              Kaynak:{" "}
              <a class="underline decoration-steel/40 underline-offset-2 hover:text-blue" href={item.sourceUrl} target="_blank" rel="noreferrer">
                fernas.com.tr
              </a>
            </p>
          )}
        </div>

        <aside class="lg:col-span-4">
          <div class="sticky top-24 border border-steel/30 p-5">
            <p class="mono text-[0.62rem] text-steel">HABER</p>
            <p class="mt-4 font-display text-[1.3rem] font-semibold leading-[1.05] tracking-[-0.03em]">
              {item.category}
            </p>
            <p class="mt-2 text-[0.85rem] text-ink/60">{formatDate(item.publishedAt)}</p>
            <div class="mt-6 border-t border-steel/30 pt-4">
              <a class="link-underline" href="/haberler/">Tüm haberler</a>
            </div>
          </div>
        </aside>
      </div>
    </section>
  </article>

  <section class="section bg-white">
    <div class="shell grid gap-6 sm:grid-cols-2">
      <a class="group border border-steel/30 p-6 transition-colors hover:border-blue" href={`/haberler/${previous.slug}/`}>
        <p class="mono text-[0.62rem] text-steel">ÖNCEKİ</p>
        <p class="mt-4 font-display text-[1.35rem] font-semibold leading-[1.08] tracking-[-0.03em] group-hover:text-blue">
          {previous.title}
        </p>
      </a>
      <a class="group border border-steel/30 p-6 text-right transition-colors hover:border-blue" href={`/haberler/${next.slug}/`}>
        <p class="mono text-[0.62rem] text-steel">SONRAKİ</p>
        <p class="mt-4 font-display text-[1.35rem] font-semibold leading-[1.08] tracking-[-0.03em] group-hover:text-blue">
          {next.title}
        </p>
      </a>
    </div>
  </section>
</Base>
