---
import * as cheerio from "cheerio";
import Base from "../../layouts/Base.astro";
import PhotoBand from "../../components/ui/PhotoBand.astro";
import about from "../../content/pages/hakkimizda.json";
import { loadProjects, type ProjectRecord } from "../../lib/projects";

const $ = cheerio.load(about.body_html_en);
const paragraphs = $("p")
  .toArray()
  .map((element) => $(element).html() ?? "")
  .filter(Boolean);

const profile = paragraphs.slice(0, 8);
const mission = paragraphs[8] ?? "";
const vision = paragraphs[9] ?? "";
const foundation = paragraphs[10] ?? "";
const scholarship = paragraphs[11] ?? "";

const bySlug = new Map(loadProjects().map((project) => [project.slug, project]));
const pick = (slug: string): ProjectRecord => {
  const project = bySlug.get(slug);
  if (!project) throw new Error(`Project not found — ${slug}`);
  return project;
};

const band = [
  "sinop-ayancik-devlet-yolu",
  "cape-bodrum-luxury-hotel-beach",
  "sebenoba-ruzgar-enerji-santrali",
].map(pick);

const image800 = (src: string) => src.replace(/cover-1600\.webp$/, "cover-800.webp");
---

<Base
  title="About — Fernas Group"
  description="Fernas was founded in 1982 and operates in construction, energy, gas distribution, industry, food and tourism across Türkiye and international markets."
  lang="en"
  trPath="/grup/hakkimizda/"
  enPath="/en/about/"
>
  <section class="section">
    <div class="shell">
      <nav class="mono flex flex-wrap items-center gap-2 text-[0.64rem] text-steel" aria-label="Breadcrumb">
        <a class="hover:text-blue" href="/en/">Home</a>
        <span aria-hidden="true">/</span>
        <span class="text-ink">About</span>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">The group</p>
          <h1 class="mt-5 max-w-[14ch] font-display text-[clamp(2.8rem,5vw,5rem)] font-semibold leading-[0.86] tracking-[-0.06em]">
            About Fernas.
          </h1>
        </div>
        <div class="lg:col-span-5 lg:pt-16">
          <p class="section-lede">
            A group founded in Ankara in 1982, with work across Türkiye, the
            Middle East, South Asia and the Turkic republics.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="measure-band">
    <div class="shell">
      <div class="measure-grid">
        <div class="measure-item">
          <strong>1982</strong>
          <small>Founded</small>
        </div>
        <div class="measure-item">
          <strong>6</strong>
          <small>Sectors</small>
        </div>
        <div class="measure-item">
          <strong>570<span>MW</span></strong>
          <small>Installed capacity</small>
        </div>
        <div class="measure-item">
          <strong>14</strong>
          <small>Facilities</small>
        </div>
        <div class="measure-item">
          <strong>60<span>+</span></strong>
          <small>Projects</small>
        </div>
      </div>
    </div>
  </section>

  <PhotoBand
    label="From the field"
    items={band.map((project) => ({
      src: image800(project.cover),
      alt: `${project.titleEn || project.title} — Fernas`,
      caption: [project.titleEn || project.title, project.year].filter(Boolean).join(" · "),
    }))}
  />

  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-8">
        <p class="eyebrow">Company profile</p>
        <div class="prose-fernas mt-6">
          {profile.map((paragraph) => (
            <p set:html={paragraph} />
          ))}
        </div>
        <p class="mono mt-8 text-[0.62rem] leading-relaxed text-steel">
          Company profile text is taken from Fernas corporate records.
        </p>
      </div>

      <aside class="lg:col-span-4">
        <div class="sticky top-24 border border-steel/30">
          <div class="border-b border-steel/30 p-5">
            <p class="mono text-[0.62rem] text-steel">AT A GLANCE</p>
          </div>
          <dl>
            {[
              ["Founded", "1982"],
              ["Headquarters", "Ankara, Türkiye"],
              ["Sectors", "Construction, energy, gas distribution, industry, food, tourism"],
              ["Energy", "570 MW installed · 485 MW in operation"],
              ["Facilities", "14 production facilities"],
            ].map(([label, value]) => (
              <div class="grid grid-cols-[6.5rem_1fr] gap-3 border-b border-steel/20 px-5 py-3 last:border-b-0">
                <dt class="mono text-[0.62rem] text-steel">{label}</dt>
                <dd class="text-[0.86rem] leading-relaxed">{value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="mt-6 flex flex-col gap-3">
          <a class="btn btn-primary" href="/en/projects/">Project archive</a>
          <a class="btn btn-ghost" href="/en/contact/">Contact</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section rule">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">Mission and vision</p>
        <h2 class="section-title mt-5">Why the group exists.</h2>
      </div>
      <div class="lg:col-span-7">
        <div class="grid gap-px bg-steel/25 sm:grid-cols-2">
          <article class="bg-chalk p-6">
            <p class="mono text-[0.62rem] text-steel">MISSION</p>
            <p class="mt-4 text-[0.95rem] leading-relaxed text-ink/75" set:html={mission} />
          </article>
          <article class="bg-chalk p-6">
            <p class="mono text-[0.62rem] text-steel">VISION</p>
            <p class="mt-4 text-[0.95rem] leading-relaxed text-ink/75" set:html={vision} />
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">Social contribution</p>
        <h2 class="section-title mt-5">Necat Nasıroğlu Foundation.</h2>
      </div>
      <div class="lg:col-span-7">
        <div class="prose-fernas">
          <p set:html={foundation} />
          <p set:html={scholarship} />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-ink text-white">
    <div class="shell flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow text-white/75">Next</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(2rem,3.6vw,3.6rem)] font-semibold leading-[0.94] tracking-[-0.05em]">
          See the work.
        </h2>
      </div>
      <a class="btn btn-light" href="/en/projects/">Browse projects</a>
    </div>
  </section>
</Base>
