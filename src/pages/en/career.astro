---
import Base from "../../layouts/Base.astro";
import ApplicationForm from "../../components/forms/ApplicationForm";
---

<Base
  title="Careers — Fernas Group"
  description="Careers at Fernas Group: engineering, field, operations, finance and support teams. General application form."
  lang="en"
  trPath="/kariyer/"
  enPath="/en/career/"
>
  <section class="section">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow">Careers</p>
        <h1 class="mt-5 max-w-[13ch] font-display text-[clamp(2.8rem,5vw,5rem)] font-semibold leading-[0.86] tracking-[-0.06em]">
          Careers at Fernas.
        </h1>
      </div>
      <div class="lg:col-span-5 lg:pt-16">
        <p class="section-lede">
          On site, in engineering, production and the office, we work with people
          who measure what they do. Leave a general application and we will
          consider it when a suitable position opens.
        </p>
        <a class="link-underline mt-8" href="#apply">Go to the application form</a>
      </div>
    </div>
  </section>

  <section class="section rule">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">How we work</p>
        <h2 class="section-title mt-5">From site to office.</h2>
        <p class="section-lede mt-6">
          Work at Fernas moves between project, field and operation. Teams carry
          the same responsibility from building a facility to commissioning and
          operating it.
        </p>
      </div>
      <div class="lg:col-span-7">
        <div class="grid gap-0 border-t border-steel/30">
          {[
            ["Engineering", "Project, design, field application and commissioning."],
            ["Field and operations", "Operation across construction, energy, distribution and production sites."],
            ["Finance and support", "Accounting, procurement, human resources and administration."],
          ].map(([title, body]) => (
            <div class="border-b border-steel/30 py-6">
              <div>
                <h3 class="font-display text-[1.25rem] font-semibold tracking-[-0.03em]">{title}</h3>
                <p class="mt-2 max-w-lg text-[0.9rem] leading-relaxed text-ink/65">{body}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 border border-steel/30 p-6">
          <p class="mono text-[0.62rem] text-steel">OPEN POSITIONS</p>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-ink/70">
            For advertised positions, use the general application form. Selecting
            a position helps route your application to the right team.
          </p>
          <a class="link-underline mt-5" href="/en/policies/">People policies</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" id="apply">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">Application</p>
        <h2 class="section-title mt-5">General application.</h2>
        <p class="section-lede mt-6">
          Complete the form and attach your CV. Applications are reviewed by the
          human resources team.
        </p>
        <div class="mt-8 border-t border-steel/30 pt-5">
          <p class="mono text-[0.62rem] text-steel">FILE</p>
          <p class="mt-2 text-[0.88rem] leading-relaxed text-ink/65">
            PDF, DOC or DOCX. Maximum 5 MB. Using your name in the file name
            makes review easier.
          </p>
        </div>
        <div class="mt-6 border-t border-steel/30 pt-5">
          <p class="mono text-[0.62rem] text-steel">PRIVACY</p>
          <p class="mt-2 text-[0.88rem] leading-relaxed text-ink/65">
            Application data is processed only for the recruitment process.
          </p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <ApplicationForm lang="en" client:load />
      </div>
    </div>
  </section>
</Base>
