---
import Base from "../../../layouts/Base.astro";
import VideoFacade from "../../../components/ui/VideoFacade.astro";
import { loadProjects } from "../../../lib/projects";

export function getStaticPaths() {
  return loadProjects().map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const statusLabels: Record<string, string> = {
  tamamlandi: "Completed",
  "devam-ediyor": "Ongoing",
  isletmede: "In operation",
  planlama: "Planning",
};

const title = project.titleEn || project.title;
const scope = project.scopeEn || project.scope;
const bodyHtml = (project.bodyHtmlEn || project.bodyHtml)
  .replace(/<script[\s\S]*?<\/script>/gi, "")
  .replace(/<style[\s\S]*?<\/style>/gi, "");
const hasEnglish = Boolean(project.bodyHtmlEn || project.scopeEn);
const status = statusLabels[project.status] ?? project.status;

const facts = [
  ["Sector", project.sectorEn],
  ["City", project.city],
  ["Country", project.country],
  ["Year", project.year],
  ["Capacity", project.capacity],
  ["Client", project.client],
  ["Status", status],
].filter(([, value]) => Boolean(value));

const all = loadProjects();
const currentIndex = all.findIndex((item) => item.slug === project.slug);
const next = all[(currentIndex + 1) % all.length];
const previous = all[(currentIndex - 1 + all.length) % all.length];
const related = all
  .filter((item) => item.slug !== project.slug && item.sectorSlug === project.sectorSlug)
  .slice(0, 3);

const image800 = (src: string) => src.replace(/cover-1600\.webp$/, "cover-800.webp");
const itemTitle = (item: (typeof all)[number]) => item.titleEn || item.title;

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.fernas.com.tr/en/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Projects",
      item: "https://www.fernas.com.tr/en/projects/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
      item: `https://www.fernas.com.tr/en/projects/${project.slug}/`,
    },
  ],
};
---

<Base
  title={`${title} — Fernas Group`}
  description={`${title}. ${[project.sectorEn, project.city, project.year].filter(Boolean).join(" · ")}.`}
  image={project.cover || undefined}
  jsonLd={breadcrumbLd}
  lang="en"
  trPath={`/projeler/${project.slug}/`}
  enPath={`/en/projects/${project.slug}/`}
>
  <div class="shell">
    <nav
      class="mono flex flex-wrap items-center gap-2 pt-6 text-[0.64rem] text-steel"
      aria-label="Breadcrumb"
    >
      <a class="hover:text-blue" href="/en/">Home</a>
      <span aria-hidden="true">/</span>
      <a class="hover:text-blue" href="/en/projects/">Projects</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink">{title}</span>
    </nav>
  </div>

  {project.cover && (
    <figure class="project-cover mt-6">
      <img
        src={project.cover}
        srcset={`${image800(project.cover)} 800w, ${project.cover} 1600w`}
        sizes="100vw"
        alt={`${title} — Fernas`}
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  )}

  <section class="section">
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-8">
          <p class="eyebrow">{[project.sectorEn, status].filter(Boolean).join(" · ")}</p>
          <h1 class="mt-5 max-w-[20ch] font-display text-[clamp(2.4rem,4.4vw,4.6rem)] font-semibold leading-[0.9] tracking-[-0.055em]">
            {title}
          </h1>

          <dl class="mt-8 grid grid-cols-2 gap-y-4 border-y border-steel/30 py-5 sm:grid-cols-4">
            {[
              ["City", project.city],
              ["Country", project.country],
              ["Year", project.year],
              ["Capacity", project.capacity],
            ]
              .filter(([, value]) => Boolean(value))
              .map(([label, value]) => (
                <div>
                  <dt class="mono text-[0.6rem] text-steel">{label}</dt>
                  <dd class="mt-1 text-[0.92rem]">{value}</dd>
                </div>
              ))}
          </dl>

          <div class="mt-10">
            {!hasEnglish && (
              <div class="mb-10 max-w-xl border-l-2 border-amber pl-5">
                <p class="text-[0.95rem] leading-relaxed text-ink/70">
                  The detailed record for this project is available in Turkish.
                </p>
                <a class="link-underline mt-3" href={`/projeler/${project.slug}/`}>
                  View Turkish record
                </a>
              </div>
            )}

            {bodyHtml ? (
              <div class="prose-fernas" set:html={bodyHtml} />
            ) : scope ? (
              <p class="max-w-2xl text-[1.05rem] leading-relaxed text-ink/75">{scope}</p>
            ) : (
              <div class="max-w-xl border-l-2 border-amber pl-5">
                <p class="text-[0.98rem] leading-relaxed text-ink/70">
                  This project is held in the archive. Use the contact form for
                  scope, site and technical information.
                </p>
                <a class="link-underline mt-4" href="/en/contact/">Request information</a>
              </div>
            )}
          </div>

          {project.video && project.videoPoster && (
            <div class="mt-12">
              <VideoFacade
                src={project.video}
                poster={project.videoPoster}
                title={title}
                caption={`${title} — site footage`}
                lang="en"
              />
            </div>
          )}

          {project.gallery.length > 0 && (
            <div class="mt-12">
              <h2 class="font-display text-[1.4rem] font-semibold tracking-[-0.03em]">Gallery</h2>
              <div class="mt-5 grid gap-1 sm:grid-cols-2">
                {project.gallery.map((image, index) => (
                  <figure class="overflow-hidden bg-ink">
                    <img
                      src={image}
                      alt={`${title} — image ${index + 1}`}
                      width="1200"
                      height="800"
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/3] w-full object-cover"
                    />
                  </figure>
                ))}
              </div>
            </div>
          )}
        </div>

        <aside class="lg:col-span-4">
          <div class="sticky top-24">
            <div class="border border-steel/30">
              <div class="border-b border-steel/30 px-5 py-4">
                <h2 class="mono text-[0.62rem] text-steel">Fact sheet</h2>
              </div>
              <dl>
                {facts.map(([label, value]) => (
                  <div class="grid grid-cols-[6.5rem_1fr] gap-3 border-b border-steel/20 px-5 py-3 last:border-b-0">
                    <dt class="mono text-[0.62rem] text-steel">{label}</dt>
                    <dd class="text-[0.86rem] leading-relaxed">{value}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="mt-6 border border-steel/30 p-5">
              <h2 class="mono text-[0.62rem] text-steel">Share</h2>
              <div class="mt-3 flex flex-wrap gap-3 text-[0.8rem]">
                <a
                  class="link-underline"
                  href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`https://www.fernas.com.tr/en/projects/${project.slug}/`)}`}
                >
                  Email
                </a>
                <a
                  class="link-underline"
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://www.fernas.com.tr/en/projects/${project.slug}/`)}`}
                  target="_blank"
                  rel="noreferrer"
                >
                  LinkedIn
                </a>
              </div>
            </div>

            {project.sourceUrl && (
              <p class="mono mt-4 text-[0.6rem] leading-relaxed text-steel">
                Source:{" "}
                <a
                  class="underline decoration-steel/40 underline-offset-2 hover:text-blue"
                  href={project.sourceUrl}
                  target="_blank"
                  rel="noreferrer"
                >
                  fernas.com.tr
                </a>
              </p>
            )}
          </div>
        </aside>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section bg-white">
      <div class="shell">
        <div class="home-head">
          <div>
            <h2>From the same sector.</h2>
          </div>
          <a class="home-link" href="/en/projects/">All projects</a>
        </div>

        <div class="project-grid">
          {related.map((item) => (
            <a class="project-card" href={`/en/projects/${item.slug}/`}>
              {item.cover && (
                <div class="project-card__media">
                  <img
                    src={image800(item.cover)}
                    srcset={`${image800(item.cover)} 800w, ${item.cover} 1600w`}
                    sizes="(max-width: 767px) 100vw, (max-width: 900px) 45vw, 28rem"
                    alt={`${itemTitle(item)} — Fernas`}
                    width="800"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="project-card__plate">
                <p class="project-card__meta">
                  {[item.city, item.year, item.capacity].filter(Boolean).join(" · ")}
                </p>
                <h3>{itemTitle(item)}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="shell grid gap-4 sm:grid-cols-2">
      <a class="group border border-steel/30 p-6 transition-colors hover:border-blue" href={`/en/projects/${previous.slug}/`}>
        <p class="mono text-[0.62rem] text-steel">Previous record</p>
        <p class="mt-4 font-display text-[1.35rem] font-semibold leading-[1.05] tracking-[-0.03em] group-hover:text-blue">
          {itemTitle(previous)}
        </p>
      </a>
      <a class="group border border-steel/30 p-6 text-right transition-colors hover:border-blue" href={`/en/projects/${next.slug}/`}>
        <p class="mono text-[0.62rem] text-steel">Next record</p>
        <p class="mt-4 font-display text-[1.35rem] font-semibold leading-[1.05] tracking-[-0.03em] group-hover:text-blue">
          {itemTitle(next)}
        </p>
      </a>
    </div>
  </section>
</Base>
