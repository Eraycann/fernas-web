---
import Base from "../../layouts/Base.astro";
import sectors from "../../data/sectors.json";
import stats from "../../data/stats.json";
import site from "../../data/site.json";
import { loadProjects } from "../../lib/projects";
import { loadNews } from "../../lib/news";

const sectorCopy: Record<
  string,
  { name: string; description: string; metric: string }
> = {
  insaat: {
    name: "Construction",
    description: "Roads, bridges, tunnels and infrastructure.",
    metric: "Since 1982",
  },
  enerji: {
    name: "Energy",
    description: "Hydroelectric, wind and solar power plants.",
    metric: "570 MW",
  },
  "dogalgaz-dagitim": {
    name: "Gas Distribution",
    description: "Distribution and subscriber services in Diyarbakır.",
    metric: "1.5M people",
  },
  sanayi: {
    name: "Industry",
    description: "Industrial production in Aksaray, Ankara and Batman.",
    metric: "14 facilities",
  },
  gida: {
    name: "Food",
    description: "Agricultural production, processing and cold storage.",
    metric: "Since 2015",
  },
  turizm: {
    name: "Tourism",
    description: "Hospitality operations on the Aegean coast.",
    metric: "Cape Bodrum",
  },
};

const statLabels = [
  "Installed capacity",
  "In operation",
  "Facilities",
  "Population served",
  "Projects",
];

const projectSelection = loadProjects().slice(0, 6);
const news = loadNews().slice(0, 3);

const formatDate = (value: string) =>
  value
    ? new Date(`${value.slice(0, 10)}T12:00:00`).toLocaleDateString("en-GB", {
        day: "2-digit",
        month: "long",
        year: "numeric",
      })
    : "";

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Fernas Group",
  url: "https://www.fernas.com.tr/en/",
  inLanguage: "en-US",
};
---

<Base
  title="Fernas Group — Building lasting value since 1982"
  description="Fernas Group operates in construction, energy, gas distribution, industry, food and tourism. 570 MW installed capacity, 14 facilities, more than 60 projects."
  lang="en"
  trPath="/"
  enPath="/en/"
  jsonLd={websiteLd}
>
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero__media" aria-hidden="true">
      <img
        src="/images/projects/fernas-4-gunes-enerji-santrali/cover-1600.webp"
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="shell home-hero__inner">
      <div class="home-hero__content">
        <p class="eyebrow eyebrow--light">Fernas Group</p>
        <h1 id="home-hero-title">Building lasting value since 1982.</h1>
        <p class="home-hero__lede">
          Fernas operates in construction, energy, gas distribution, industry,
          food and tourism, bringing investment, construction and operating
          responsibility together.
        </p>
        <div class="home-hero__actions">
          <a class="btn btn-white" href="/en/about/">About the group</a>
          <a class="btn btn-light" href="/en/projects/">Our projects</a>
        </div>
      </div>

      <dl class="home-hero__stats" aria-label="Group measurements">
        {stats.map((stat, index) => (
          <div>
            <dt>{statLabels[index] ?? stat.label}</dt>
            <dd>
              {stat.valueEn ?? stat.value}
              {stat.unit && <span>{stat.unit}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="news-strip">
    <div class="shell news-strip__inner">
      <span class="news-strip__label">News</span>
      <div class="news-strip__items">
        {news.map((item) => (
          <a href={`/en/news/${item.slug}/`}>{item.titleEn || item.title}</a>
        ))}
      </div>
      <a class="news-strip__all" href="/en/news/">All news</a>
    </div>
  </div>

  <section class="section bg-white">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow eyebrow--accent">About the group</p>
        <h2 class="section-title mt-5">Engineering, investment and operation.</h2>
      </div>

      <div class="lg:col-span-7 lg:pt-8">
        <p class="max-w-2xl text-[1.06rem] leading-relaxed text-ink/70">
          Fernas was founded in Ankara in 1982. The group operates in
          construction, energy, gas distribution, industry, food and tourism,
          with projects in Türkiye, the Middle East, South Asia and the Turkic
          republics.
        </p>
        <p class="mt-4 max-w-2xl text-[1.06rem] leading-relaxed text-ink/70">
          Group companies take responsibility for operating their facilities
          over the long term, not only for building them.
        </p>
        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
          <a class="link-underline" href="/en/about/">About</a>
          <a class="link-underline" href="/en/policies/">Policies</a>
          <a class="link-underline" href="/en/sustainability/">Sustainability</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-chalk" id="sectors">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--accent">Business areas</p>
          <h2 class="section-title mt-5">Six sectors, one group.</h2>
        </div>
        <a class="link-underline" href="/en/about/">About the group</a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sectors.map((sector) => {
          const copy = sectorCopy[sector.slug];
          return (
            <a
              class="content-card group"
              href={`/en/projects/?sector=${sector.slug}`}
            >
              <div class="content-card__media">
                <img
                  src={`/images/sectors/${sector.slug}.webp`}
                  alt={`${copy.name} — Fernas`}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="content-card__body">
                <div class="flex items-start justify-between gap-4">
                  <h3 class="content-card__title">{copy.name}</h3>
                  <span class="mono shrink-0 pt-1 text-[0.62rem] text-steel">
                    {copy.metric}
                  </span>
                </div>
                <p class="mt-3 text-[0.9rem] leading-relaxed text-ink/65">
                  {copy.description}
                </p>
                <span class="content-card__link">
                  View projects <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section bg-white" id="projects">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--accent">Projects</p>
          <h2 class="section-title mt-5">Selected projects.</h2>
        </div>
        <a class="link-underline" href="/en/projects/">All projects</a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projectSelection.map((project) => (
          <a class="content-card group" href={`/en/projects/${project.slug}/`}>
            {project.cover && (
              <div class="content-card__media">
                <img
                  src={project.cover}
                  alt={`${project.titleEn || project.title} — Fernas`}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="content-card__body">
              <p class="mono text-[0.62rem] text-steel">
                {[project.sectorEn, project.city, project.year].filter(Boolean).join(" · ")}
              </p>
              <h3 class="content-card__title mt-3">
                {project.titleEn || project.title}
              </h3>
              <span class="content-card__link">
                View project <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-ink text-white">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-6">
        <p class="eyebrow eyebrow--light">Sustainability</p>
        <h2 class="section-title mt-5">All of our energy is renewable.</h2>
        <p class="mt-6 max-w-xl text-[1.02rem] leading-relaxed text-white/70">
          All 570 MW of installed capacity comes from renewable sources. 485 MW
          is in operation, with production, environmental impact and operating
          efficiency tracked together.
        </p>
        <a class="btn btn-light mt-8" href="/en/sustainability/">
          Sustainability
        </a>
      </div>

      <div class="lg:col-span-6">
        <div class="sustain-panel">
          <div>
            <strong>570<span>MW</span></strong>
            <small>Installed capacity</small>
          </div>
          <div>
            <strong>485<span>MW</span></strong>
            <small>In operation</small>
          </div>
          <div>
            <strong>100%</strong>
            <small>Renewable source</small>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-chalk">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--accent">News</p>
          <h2 class="section-title mt-5">News from the group.</h2>
        </div>
        <a class="link-underline" href="/en/news/">All news</a>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {news.map((item) => (
          <a class="content-card group" href={`/en/news/${item.slug}/`}>
            {item.cover && (
              <div class="content-card__media">
                <img
                  src={item.cover}
                  alt={item.titleEn || item.title}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="content-card__body">
              <p class="mono text-[0.62rem] text-steel">
                {formatDate(item.publishedAt)} · {item.category}
              </p>
              <h3 class="content-card__title mt-3">
                {item.titleEn || item.title}
              </h3>
              <p class="mt-3 text-[0.88rem] leading-relaxed text-ink/65">
                {item.excerptEn || item.excerpt}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-blue text-white">
    <div class="shell flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow eyebrow--light">Contact</p>
        <h2 class="mt-5 max-w-[18ch] font-display text-[clamp(2rem,3.6vw,3.6rem)] font-semibold leading-[0.98] tracking-[-0.045em]">
          Let's discuss your project.
        </h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-white" href="/en/contact/">Get in touch</a>
        <a class="btn btn-light" href={`tel:${site.phoneHref}`}>{site.phone}</a>
      </div>
    </div>
  </section>
</Base>
