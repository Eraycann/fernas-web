---
import Base from "../../layouts/Base.astro";
import FieldRail from "../../components/home/FieldRail.astro";
import home from "../../data/home.json";
import sectors from "../../data/sectors.json";
import stats from "../../data/stats.json";
import site from "../../data/site.json";
import timeline from "../../data/timeline.json";
import { loadProjects, type ProjectRecord } from "../../lib/projects";
import { loadNews } from "../../lib/news";
import "../../styles/home.css";

const allProjects = loadProjects();
const bySlug = new Map(allProjects.map((project) => [project.slug, project]));

const pick = (slug: string): ProjectRecord => {
  const project = bySlug.get(slug);
  if (!project) throw new Error(`home.json: project not found — ${slug}`);
  return project;
};

const hero = pick(home.hero);
const feature = pick(home.feature);
const sustain = pick(home.sustainPhoto);
const rail = home.rail.map(pick);
const featured = home.featured.map(pick);
const introPhotos = home.introPhotos.map(pick);
const sectorMedia = home.sectorMedia as Record<string, string>;
const news = loadNews().slice(0, 3);

const image800 = (src: string) => src.replace(/cover-1600\.webp$/, "cover-800.webp");

const sectorCopy: Record<string, { name: string; short: string; metric: string }> = {
  insaat: { name: "Construction", short: "Roads, bridges, tunnels and infrastructure", metric: "Since 1982" },
  enerji: { name: "Energy", short: "Hydroelectric, wind and solar", metric: "570 MW" },
  "dogalgaz-dagitim": { name: "Gas Distribution", short: "Diyarbakır and the region", metric: "1.5M people" },
  sanayi: { name: "Industry", short: "Production and industrial investment", metric: "14 facilities" },
  gida: { name: "Food", short: "Agriculture and food production", metric: "Since 2015" },
  turizm: { name: "Tourism", short: "Cape Bodrum", metric: "Cape Bodrum" },
};

const statLabels = [
  "Installed capacity",
  "In operation",
  "Facilities",
  "Population served",
  "Projects",
];

const title = (project: ProjectRecord) => project.titleEn || project.title;

const formatDate = (value: string) =>
  value
    ? new Date(`${value.slice(0, 10)}T12:00:00`).toLocaleDateString("en-GB", {
        day: "2-digit",
        month: "long",
        year: "numeric",
      })
    : "";

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Fernas Group",
  url: "https://www.fernas.com.tr/en/",
  inLanguage: "en-US",
};
---

<Base
  title="Fernas Group — Building lasting value since 1982"
  description="Fernas Group operates in construction, energy, gas distribution, industry, food and tourism. 570 MW installed capacity, 14 facilities, more than 60 projects."
  lang="en"
  trPath="/"
  enPath="/en/"
  jsonLd={websiteLd}
  preloadImage={home.heroMedia.src}
  preloadImageSrcSet={home.heroMedia.srcset}
>
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero__media" aria-hidden="true">
      <img
        src={home.heroMedia.src}
        srcset={home.heroMedia.srcset}
        sizes="100vw"
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="home-hero__scrim" aria-hidden="true"></div>

    <div class="shell home-hero__inner">
      <div class="home-hero__top">
        <span>Ankara · Türkiye</span>
        <span>Since 1982</span>
      </div>

      <div class="home-hero__main">
        <div>
          <p class="home-hero__kick">Fernas Group</p>
          <h1 id="home-hero-title">Building lasting value since 1982.</h1>
          <p class="home-hero__lede">
            Fernas operates in construction, energy, gas distribution, industry,
            food and tourism, bringing investment, construction and operating
            responsibility together.
          </p>
          <div class="home-hero__actions">
            <a class="btn btn-white" href="/en/about/">About the group</a>
            <a class="btn btn-light" href="/en/projects/">Our projects</a>
          </div>
        </div>

        <div class="home-hero__plate">
          <span>From the field</span>
          <strong>{title(hero)}</strong>
          <span>
            {[hero.year, hero.capacity, hero.sectorEn || hero.sector].filter(Boolean).join(" · ")}
          </span>
        </div>
      </div>

      <dl class="home-hero__stats" aria-label="Group measurements">
        {stats.map((stat, index) => (
          <div>
            <dt>{statLabels[index] ?? stat.label}</dt>
            <dd>
              {stat.valueEn ?? stat.value}
              {stat.unit && <span>{stat.unit}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="news-strip">
    <div class="shell news-strip__inner">
      <span class="news-strip__label">News</span>
      <div class="news-strip__items">
        {news.map((item) => (
          <a href={`/en/news/${item.slug}/`}>{item.titleEn || item.title}</a>
        ))}
      </div>
      <a class="news-strip__all" href="/en/news/">All news</a>
    </div>
  </div>

  <section class="section bg-white">
    <div class="shell home-intro__grid">
      <div class="home-intro__copy">
        <p class="home-kicker">About the group</p>
        <h2>Engineering, investment and operation.</h2>
        <p>
          Fernas was founded in Ankara in 1982. The group operates in
          construction, energy, gas distribution, industry, food and tourism,
          with projects in Türkiye, the Middle East, South Asia and the Turkic
          republics.
        </p>
        <p>
          Group companies take responsibility for operating their facilities
          over the long term, not only for building them.
        </p>
        <div class="home-intro__links">
          <a class="link-underline" href="/en/about/">About</a>
          <a class="link-underline" href="/en/policies/">Policies</a>
          <a class="link-underline" href="/en/sustainability/">Sustainability</a>
        </div>
      </div>

      <div>
        <div class="home-intro__figures">
          {introPhotos.map((project) => (
            <figure>
              <img
                src={project.cover}
                srcset={`${image800(project.cover)} 800w, ${project.cover} 1600w`}
                sizes="(max-width: 900px) 45vw, 24rem"
                alt={`${title(project)} — Fernas`}
                width="800"
                height="1000"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                {title(project)}
                {project.city ? ` · ${project.city}` : ""}
              </figcaption>
            </figure>
          ))}
        </div>

        <dl class="home-intro__timeline">
          {timeline.map((item) => (
            <div>
              <dt>{item.year === "Bugün" ? "Today" : item.year}</dt>
              <dd>
                <strong>{item.titleEn ?? item.title}</strong>
                <span>{item.bodyEn ?? item.body}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <FieldRail projects={rail} index={allProjects.length} lang="en" />

  <section class="section bg-chalk" id="sectors">
    <div class="shell">
      <div class="home-head">
        <div>
          <h2>Six sectors. One group.</h2>
          <p>
            Every sector carries its own engineering and operating rhythm. The
            shared discipline is to invest, operate and keep the asset working.
          </p>
        </div>
        <a class="home-link" href="/en/about/">About the group</a>
      </div>

      <div class="sector-mosaic">
        {sectors.map((sector, index) => {
          const copy = sectorCopy[sector.slug];
          const media = pick(sectorMedia[sector.slug]);
          return (
            <a
              class:list={["sector-tile", index === 0 && "sector-tile--feature"]}
              href={`/en/projects/?sector=${sector.slug}`}
            >
              <div class="sector-tile__media">
                <img
                  src={index === 0 ? media.cover : image800(media.cover)}
                  srcset={`${image800(media.cover)} 800w, ${media.cover} 1600w`}
                  sizes={index === 0 ? "(max-width: 767px) 100vw, 62rem" : "(max-width: 767px) 100vw, 30rem"}
                  alt={`${copy.name} — ${title(media)}`}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="sector-tile__body">
                <h3>{copy.name}</h3>
                <span class="sector-tile__metric">{copy.metric}</span>
              </div>
              <p class="sector-tile__short">{copy.short}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section bg-white" id="projects">
    <div class="shell">
      <div class="home-head">
        <div>
          <h2>Work you can measure.</h2>
          <p>
            Dams, roads, factories and facilities. Every record in the archive
            keeps the work, its year and its scale together.
          </p>
        </div>
        <a class="home-link" href="/en/projects/">
          All projects · {allProjects.length}
        </a>
      </div>

      <a class="feature-project" href={`/en/projects/${feature.slug}/`}>
        <div class="feature-project__media">
          <img
            src={feature.cover}
            srcset={`${image800(feature.cover)} 800w, ${feature.cover} 1600w`}
            sizes="(max-width: 767px) 100vw, 90rem"
            alt={`${title(feature)} — Fernas`}
            width="1600"
            height="686"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="feature-project__plate">
          <h3>{title(feature)}</h3>
          <p class="feature-project__facts">
            {[feature.sectorEn, feature.city, feature.year, feature.capacity]
              .filter(Boolean)
              .map((fact) => (
                <span>{fact}</span>
              ))}
          </p>
        </div>
      </a>

      <div class="project-grid">
        {featured.map((project) => (
          <a class="project-card" href={`/en/projects/${project.slug}/`}>
            <div class="project-card__media">
              <img
                src={project.cover}
                srcset={`${image800(project.cover)} 800w, ${project.cover} 1600w`}
                sizes="(max-width: 767px) 100vw, (max-width: 900px) 45vw, 28rem"
                alt={`${title(project)} — Fernas`}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="project-card__plate">
              <p class="project-card__meta">
                {[project.sectorEn, project.city, project.year, project.capacity]
                  .filter(Boolean)
                  .join(" · ")}
              </p>
              <h3>{title(project)}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-sustain" aria-labelledby="home-sustain-title">
    <div class="home-sustain__media" aria-hidden="true">
      <img
        src={sustain.cover}
        srcset={`${image800(sustain.cover)} 800w, ${sustain.cover} 1600w`}
        sizes="100vw"
        alt=""
        width="1600"
        height="900"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="home-sustain__scrim" aria-hidden="true"></div>

    <div class="shell home-sustain__inner">
      <div>
        <p class="home-hero__kick">Sustainability</p>
        <h2 id="home-sustain-title">All of our energy is renewable.</h2>
        <p>
          All 570 MW of installed capacity comes from renewable sources. 485 MW
          is in operation, with production, environmental impact and operating
          efficiency tracked together.
        </p>
        <div class="home-sustain__actions">
          <a class="btn btn-light" href="/en/sustainability/">Sustainability</a>
          <a class="btn btn-light" href="/en/policies/">ISO documents</a>
        </div>
      </div>

      <div class="home-sustain__panel">
        <div>
          <strong>570<span>MW</span></strong>
          <small>Installed capacity</small>
        </div>
        <div>
          <strong>485<span>MW</span></strong>
          <small>In operation</small>
        </div>
        <div>
          <strong>100%</strong>
          <small>Renewable source</small>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="shell">
      <div class="home-head">
        <div>
          <h2>News from the group.</h2>
          <p>Project agreements, energy investments and records from the field.</p>
        </div>
        <a class="home-link" href="/en/news/">All news</a>
      </div>

      <div class="news-list">
        {news.map((item) => (
          <a class="news-item" href={`/en/news/${item.slug}/`}>
            <p class="news-item__date">
              {formatDate(item.publishedAt)}
              <span>{item.category}</span>
            </p>
            <div>
              <h3>{item.titleEn || item.title}</h3>
              <p class="news-item__excerpt">{item.excerptEn || item.excerpt}</p>
            </div>
            {item.cover && (
              <div class="news-item__thumb">
                <img
                  src={image800(item.cover)}
                  alt=""
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-cta">
    <div class="shell">
      <div class="home-cta__row">
        <div>
          <p class="eyebrow eyebrow--light">Contact</p>
          <h2>Let's discuss your project.</h2>
        </div>
        <div class="home-cta__actions">
          <a class="btn btn-white" href="/en/contact/">Get in touch</a>
          <a class="btn btn-light" href={`tel:${site.phoneHref}`}>{site.phone}</a>
        </div>
      </div>
      <div class="home-cta__foot">
        <span>
          {site.address.street}, {site.address.district} · {site.address.postalCode}{" "}
          {site.address.city} / {site.address.region}
        </span>
        <span>Ankara · Türkiye</span>
      </div>
    </div>
  </section>
</Base>
