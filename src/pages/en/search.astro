---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Search"
  description="Search the Fernas Group website: projects, news, sectors and company pages."
  lang="en"
  trPath="/arama/"
  enPath="/en/search/"
  noindex
>
  <section class="section" data-pagefind-ignore>
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow">Search</p>
          <h1 class="mt-5 max-w-[10ch] font-display text-[clamp(2.8rem,5vw,5rem)] font-semibold leading-[0.86] tracking-[-0.06em]">
            Search.
          </h1>
          <p class="section-lede mt-7">
            Search across projects, news, sectors and company pages.
          </p>
        </div>

        <div class="lg:col-span-7">
          <div id="search" class="min-h-40"></div>
          <noscript>
            <p class="mt-6 text-[0.9rem] leading-relaxed text-ink/65">
              Search requires JavaScript. You can go directly to the
              <a class="text-blue underline underline-offset-2" href="/en/projects/">project archive</a>.
            </p>
          </noscript>
        </div>
      </div>
    </div>
  </section>

  <section class="section rule" data-pagefind-ignore>
    <div class="shell flex flex-wrap gap-x-8 gap-y-3">
      <a class="link-underline" href="/en/projects/">Projects</a>
      <a class="link-underline" href="/en/news/">News</a>
      <a class="link-underline" href="/en/policies/">Policies</a>
      <a class="link-underline" href="/en/contact/">Contact</a>
    </div>
  </section>

  <script is:inline src="/pagefind/pagefind-ui.js" defer></script>
  <script is:inline>
    function initPagefind() {
      const target = document.querySelector("#search");
      if (!target) return;
      if (target.dataset.initialized === "true") return;

      if (typeof window.PagefindUI !== "function") {
        window.setTimeout(initPagefind, 80);
        return;
      }

      target.dataset.initialized = "true";
      new window.PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        translations: {
          placeholder: "Search projects, news or pages",
          zero_results: "No results found",
          many_results: "[COUNT] results",
          one_result: "[COUNT] result",
          searching: "Searching…",
        },
      });

      const query = new URLSearchParams(window.location.search).get("q");
      if (query) {
        const input = target.querySelector(".pagefind-ui__search-input");
        if (input) {
          input.value = query;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        }
      }
    }

    initPagefind();
  </script>
</Base>
