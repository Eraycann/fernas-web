---
import Base from "../layouts/Base.astro";
import sectors from "../data/sectors.json";
import stats from "../data/stats.json";
import site from "../data/site.json";
import { loadProjects } from "../lib/projects";
import { loadNews } from "../lib/news";

const projectSelection = loadProjects().slice(0, 6);
const news = loadNews().slice(0, 3);

const formatDate = (value: string) =>
  new Date(`${value.slice(0, 10)}T12:00:00`).toLocaleDateString("tr-TR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Fernas Şirketler Grubu",
  url: "https://www.fernas.com.tr",
  inLanguage: "tr-TR",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://www.fernas.com.tr/arama/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<Base
  title="Fernas Şirketler Grubu — 1982'den beri"
  description="Fernas Şirketler Grubu; inşaat, enerji, doğalgaz dağıtımı, sanayi, gıda ve turizm alanlarında faaliyet gösterir. 570 MW kurulu güç, 14 tesis, 60'ı aşkın proje."
  jsonLd={websiteLd}
>
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero__media" aria-hidden="true">
      <img
        src="/images/projects/fernas-4-gunes-enerji-santrali/cover-1600.webp"
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="shell home-hero__inner">
      <div class="home-hero__content">
        <p class="eyebrow eyebrow--light">Fernas Şirketler Grubu</p>
        <h1 id="home-hero-title">1982'den beri Türkiye'de ve dünyada.</h1>
        <p class="home-hero__lede">
          İnşaat, enerji, doğalgaz dağıtımı, sanayi, gıda ve turizm alanlarında
          faaliyet gösteren Fernas; yatırım, yapım ve işletme sorumluluğunu bir
          arada yürütür.
        </p>
        <div class="home-hero__actions">
          <a class="btn btn-white" href="/grup/hakkimizda/">Grubu tanıyın</a>
          <a class="btn btn-light" href="/projeler/">Projelerimiz</a>
        </div>
      </div>

      <dl class="home-hero__stats" aria-label="Grup ölçüleri">
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>
              {stat.value}
              {stat.unit && <span>{stat.unit}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="news-strip">
    <div class="shell news-strip__inner">
      <span class="news-strip__label">Haberler</span>
      <div class="news-strip__items">
        {news.map((item) => (
          <a href={`/haberler/${item.slug}/`}>{item.title}</a>
        ))}
      </div>
      <a class="news-strip__all" href="/haberler/">Tüm haberler</a>
    </div>
  </div>

  <section class="section bg-white">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow eyebrow--accent">Grup hakkında</p>
        <h2 class="section-title mt-5">Mühendislik, yatırım ve işletme.</h2>
      </div>

      <div class="lg:col-span-7 lg:pt-8">
        <p class="max-w-2xl text-[1.06rem] leading-relaxed text-ink/70">
          Fernas, 1982'de Ankara'da kuruldu. İnşaat, enerji, doğalgaz dağıtımı,
          sanayi, gıda ve turizm alanlarında faaliyet gösteren grup; Türkiye'nin
          yanı sıra Orta Doğu, Güney Asya ve Türk cumhuriyetlerinde projeler
          üstlendi.
        </p>
        <p class="mt-4 max-w-2xl text-[1.06rem] leading-relaxed text-ink/70">
          Grup şirketleri; projelerin yapımı kadar tesislerin uzun vadeli
          işletilmesini de sorumluluk alanı olarak görür.
        </p>
        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
          <a class="link-underline" href="/grup/hakkimizda/">Hakkımızda</a>
          <a class="link-underline" href="/grup/tarihce/">Tarihçe</a>
          <a class="link-underline" href="/grup/uyelikler/">Üyelikler</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-chalk" id="sektorler">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--accent">Faaliyet alanları</p>
          <h2 class="section-title mt-5">Altı sektörde üretim ve işletme.</h2>
        </div>
        <a class="link-underline" href="/grup/hakkimizda/">Grup hakkında</a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sectors.map((sector) => (
          <a class="content-card group" href={`/sektorler/${sector.slug}/`}>
            <div class="content-card__media">
              <img
                src={`/images/sectors/${sector.slug}.webp`}
                alt={`${sector.name} — Fernas`}
                width="800"
                height="500"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="content-card__body">
              <div class="flex items-start justify-between gap-4">
                <h3 class="content-card__title">{sector.name}</h3>
                <span class="mono shrink-0 pt-1 text-[0.62rem] text-steel">
                  {sector.metric}
                </span>
              </div>
              <p class="mt-3 text-[0.9rem] leading-relaxed text-ink/65">
                {sector.short}
              </p>
              <span class="content-card__link">
                Detaylar <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white" id="projeler">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--accent">Projeler</p>
          <h2 class="section-title mt-5">Öne çıkan projeler.</h2>
        </div>
        <a class="link-underline" href="/projeler/">Tüm projeler</a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projectSelection.map((project) => (
          <a class="content-card group" href={`/projeler/${project.slug}/`}>
            {project.cover && (
              <div class="content-card__media">
                <img
                  src={project.cover}
                  alt={`${project.title} — Fernas`}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="content-card__body">
              <p class="mono text-[0.62rem] text-steel">
                {[project.sector, project.city, project.year].filter(Boolean).join(" · ")}
              </p>
              <h3 class="content-card__title mt-3">{project.title}</h3>
              <span class="content-card__link">
                Projeyi incele <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-ink text-white">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-6">
        <p class="eyebrow eyebrow--light">Sürdürülebilirlik</p>
        <h2 class="section-title mt-5">Enerjimizin tamamı yenilenebilir.</h2>
        <p class="mt-6 max-w-xl text-[1.02rem] leading-relaxed text-white/70">
          570 MW kurulu gücün tamamı yenilenebilir kaynaklardan. 485 MW
          işletmede; üretim, çevresel etki ve işletme verimliliği birlikte takip
          ediliyor.
        </p>
        <a class="btn btn-light mt-8" href="/surdurulebilirlik/">Sürdürülebilirlik</a>
      </div>

      <div class="lg:col-span-6">
        <div class="sustain-panel">
          <div>
            <strong>570<span>MW</span></strong>
            <small>Kurulu güç</small>
          </div>
          <div>
            <strong>485<span>MW</span></strong>
            <small>İşletmede</small>
          </div>
          <div>
            <strong>%100</strong>
            <small>Yenilenebilir kaynak</small>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-chalk">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--accent">Haberler</p>
          <h2 class="section-title mt-5">Gruptan haberler.</h2>
        </div>
        <a class="link-underline" href="/haberler/">Tüm haberler</a>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {news.map((item) => (
          <a class="content-card group" href={`/haberler/${item.slug}/`}>
            {item.cover && (
              <div class="content-card__media">
                <img
                  src={item.cover}
                  alt={item.title}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="content-card__body">
              <p class="mono text-[0.62rem] text-steel">
                {formatDate(item.publishedAt)} · {item.category}
              </p>
              <h3 class="content-card__title mt-3">{item.title}</h3>
              <p class="mt-3 text-[0.88rem] leading-relaxed text-ink/65">
                {item.excerpt}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-blue text-white">
    <div class="shell flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow eyebrow--light">İletişim</p>
        <h2 class="mt-5 max-w-[18ch] font-display text-[clamp(2rem,3.6vw,3.6rem)] font-semibold leading-[0.98] tracking-[-0.045em]">
          Projeniz için görüşelim.
        </h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-white" href="/iletisim/">İletişime geçin</a>
        <a class="btn btn-light" href={`tel:${site.phoneHref}`}>{site.phone}</a>
      </div>
    </div>
  </section>
</Base>
