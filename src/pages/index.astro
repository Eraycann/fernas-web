---
import Base from "../layouts/Base.astro";
import FieldRail from "../components/home/FieldRail.astro";
import home from "../data/home.json";
import sectors from "../data/sectors.json";
import stats from "../data/stats.json";
import site from "../data/site.json";
import timeline from "../data/timeline.json";
import { loadProjects, type ProjectRecord } from "../lib/projects";
import { loadNews } from "../lib/news";
import "../styles/home.css";

const allProjects = loadProjects();
const bySlug = new Map(allProjects.map((project) => [project.slug, project]));

const pick = (slug: string): ProjectRecord => {
  const project = bySlug.get(slug);
  if (!project) throw new Error(`home.json: proje bulunamadı — ${slug}`);
  return project;
};

const hero = pick(home.hero);
const feature = pick(home.feature);
const sustain = pick(home.sustainPhoto);
const rail = home.rail.map(pick);
const featured = home.featured.map(pick);
const introPhotos = home.introPhotos.map(pick);
const sectorMedia = home.sectorMedia as Record<string, string>;
const news = loadNews().slice(0, 3);

const image800 = (src: string) => src.replace(/cover-1600\.webp$/, "cover-800.webp");

const formatDate = (value: string) =>
  new Date(`${value.slice(0, 10)}T12:00:00`).toLocaleDateString("tr-TR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Fernas Şirketler Grubu",
  url: "https://www.fernas.com.tr",
  inLanguage: "tr-TR",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://www.fernas.com.tr/arama/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<Base
  title="Fernas Şirketler Grubu — 1982'den beri"
  description="Fernas Şirketler Grubu; inşaat, enerji, doğalgaz dağıtımı, sanayi, gıda ve turizm alanlarında faaliyet gösterir. 570 MW kurulu güç, 14 tesis, 60'ı aşkın proje."
  jsonLd={websiteLd}
  preloadImage={home.heroMedia.src}
  preloadImageSrcSet={home.heroMedia.srcset}
>
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero__media" aria-hidden="true">
      <img
        src={home.heroMedia.src}
        srcset={home.heroMedia.srcset}
        sizes="100vw"
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="home-hero__scrim" aria-hidden="true"></div>

    <div class="shell home-hero__inner">
      <div class="home-hero__top">
        <span>Ankara · Türkiye</span>
        <span>1982'den bugüne</span>
      </div>

      <div class="home-hero__main">
        <div>
          <p class="home-hero__kick">Fernas Şirketler Grubu</p>
          <h1 id="home-hero-title">1982'den beri Türkiye'de ve dünyada.</h1>
          <p class="home-hero__lede">
            İnşaat, enerji, doğalgaz dağıtımı, sanayi, gıda ve turizm alanlarında
            faaliyet gösteren Fernas; yatırım, yapım ve işletme sorumluluğunu bir
            arada yürütür.
          </p>
          <div class="home-hero__actions">
            <a class="btn btn-white" href="/grup/hakkimizda/">Grubu tanıyın</a>
            <a class="btn btn-light" href="/projeler/">Projelerimiz</a>
          </div>
        </div>

        <div class="home-hero__plate">
          <span>Sahadan</span>
          <strong>{hero.title}</strong>
          <span>{[hero.year, hero.capacity, hero.sector].filter(Boolean).join(" · ")}</span>
        </div>
      </div>

      <dl class="home-hero__stats" aria-label="Grup ölçüleri">
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>
              {stat.value}
              {stat.unit && <span>{stat.unit}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="news-strip">
    <div class="shell news-strip__inner">
      <span class="news-strip__label">Haberler</span>
      <div class="news-strip__items">
        {news.map((item) => (
          <a href={`/haberler/${item.slug}/`}>{item.title}</a>
        ))}
      </div>
      <a class="news-strip__all" href="/haberler/">Tüm haberler</a>
    </div>
  </div>

  <section class="section bg-white">
    <div class="shell home-intro__grid">
      <div class="home-intro__copy">
        <p class="home-kicker">Grup hakkında</p>
        <h2>Mühendislik, yatırım ve işletme.</h2>
        <p>
          Fernas, 1982'de Ankara'da kuruldu. İnşaat, enerji, doğalgaz dağıtımı,
          sanayi, gıda ve turizm alanlarında faaliyet gösteren grup; Türkiye'nin
          yanı sıra Orta Doğu, Güney Asya ve Türk cumhuriyetlerinde projeler
          üstlendi.
        </p>
        <p>
          Grup şirketleri; projelerin yapımı kadar tesislerin uzun vadeli
          işletilmesini de sorumluluk alanı olarak görür.
        </p>
        <div class="home-intro__links">
          <a class="link-underline" href="/grup/hakkimizda/">Hakkımızda</a>
          <a class="link-underline" href="/grup/tarihce/">Tarihçe</a>
          <a class="link-underline" href="/grup/uyelikler/">Üyelikler</a>
        </div>
      </div>

      <div>
        <div class="home-intro__figures">
          {introPhotos.map((project) => (
            <figure>
              <img
                src={project.cover}
                srcset={`${image800(project.cover)} 800w, ${project.cover} 1600w`}
                sizes="(max-width: 900px) 45vw, 24rem"
                alt={project.alt}
                width="800"
                height="1000"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                {project.title}
                {project.city ? ` · ${project.city}` : ""}
              </figcaption>
            </figure>
          ))}
        </div>

        <dl class="home-intro__timeline">
          {timeline.map((item) => (
            <div>
              <dt>{item.year}</dt>
              <dd>
                <strong>{item.title}</strong>
                <span>{item.body}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <FieldRail projects={rail} index={allProjects.length} />

  <section class="section bg-chalk" id="sektorler">
    <div class="shell">
      <div class="home-head">
        <div>
          <h2>Altı sektör. Tek grup.</h2>
          <p>
            Her sektör kendi mühendisliğini ve işletme ritmini taşır. Ortak çizgi;
            yatırımı kurmak, işletmek ve uzun vadede ayakta tutmak.
          </p>
        </div>
        <a class="home-link" href="/grup/hakkimizda/">Grup hakkında</a>
      </div>

      <div class="sector-mosaic">
        {sectors.map((sector, index) => {
          const media = pick(sectorMedia[sector.slug]);
          return (
            <a
              class:list={["sector-tile", index === 0 && "sector-tile--feature"]}
              href={`/sektorler/${sector.slug}/`}
            >
              <div class="sector-tile__media">
                <img
                  src={index === 0 ? media.cover : image800(media.cover)}
                  srcset={`${image800(media.cover)} 800w, ${media.cover} 1600w`}
                  sizes={index === 0 ? "(max-width: 767px) 100vw, 62rem" : "(max-width: 767px) 100vw, 30rem"}
                  alt={`${sector.name} — ${media.title}`}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="sector-tile__body">
                <h3>{sector.name}</h3>
                <span class="sector-tile__metric">{sector.metric}</span>
              </div>
              <p class="sector-tile__short">{sector.short}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section bg-white" id="projeler">
    <div class="shell">
      <div class="home-head">
        <div>
          <h2>Ölçülebilir iş.</h2>
          <p>
            Baraj, yol, fabrika ve tesis. Arşivdeki her kayıt; yapılan işi, yılı ve
            ölçeğiyle birlikte duruyor.
          </p>
        </div>
        <a class="home-link" href="/projeler/">
          Tüm projeler · {allProjects.length}
        </a>
      </div>

      <a class="feature-project" href={`/projeler/${feature.slug}/`}>
        <div class="feature-project__media">
          <img
            src={feature.cover}
            srcset={`${image800(feature.cover)} 800w, ${feature.cover} 1600w`}
            sizes="(max-width: 767px) 100vw, 90rem"
            alt={feature.alt}
            width="1600"
            height="686"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="feature-project__plate">
          <h3>{feature.title}</h3>
          <p class="feature-project__facts">
            {[feature.sector, feature.city, feature.year, feature.capacity]
              .filter(Boolean)
              .map((fact) => (
                <span>{fact}</span>
              ))}
          </p>
        </div>
      </a>

      <div class="project-grid">
        {featured.map((project) => (
          <a class="project-card" href={`/projeler/${project.slug}/`}>
            <div class="project-card__media">
              <img
                src={project.cover}
                srcset={`${image800(project.cover)} 800w, ${project.cover} 1600w`}
                sizes="(max-width: 767px) 100vw, (max-width: 900px) 45vw, 28rem"
                alt={project.alt}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="project-card__plate">
              <p class="project-card__meta">
                {[project.sector, project.city, project.year, project.capacity]
                  .filter(Boolean)
                  .join(" · ")}
              </p>
              <h3>{project.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-sustain" aria-labelledby="home-sustain-title">
    <div class="home-sustain__media" aria-hidden="true">
      <img
        src={sustain.cover}
        srcset={`${image800(sustain.cover)} 800w, ${sustain.cover} 1600w`}
        sizes="100vw"
        alt=""
        width="1600"
        height="900"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="home-sustain__scrim" aria-hidden="true"></div>

    <div class="shell home-sustain__inner">
      <div>
        <p class="home-hero__kick">Sürdürülebilirlik</p>
        <h2 id="home-sustain-title">Enerjimizin tamamı yenilenebilir.</h2>
        <p>
          570 MW kurulu gücün tamamı yenilenebilir kaynaklardan. 485 MW
          işletmede; üretim, çevresel etki ve işletme verimliliği birlikte takip
          ediliyor.
        </p>
        <div class="home-sustain__actions">
          <a class="btn btn-light" href="/surdurulebilirlik/">Sürdürülebilirlik</a>
          <a class="btn btn-light" href="/grup/kalite-belgeleri/">ISO belgeleri</a>
        </div>
      </div>

      <div class="home-sustain__panel">
        <div>
          <strong>570<span>MW</span></strong>
          <small>Kurulu güç</small>
        </div>
        <div>
          <strong>485<span>MW</span></strong>
          <small>İşletmede</small>
        </div>
        <div>
          <strong>%100</strong>
          <small>Yenilenebilir kaynak</small>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="shell">
      <div class="home-head">
        <div>
          <h2>Gruptan haberler.</h2>
          <p>Proje anlaşmaları, enerji yatırımları ve sahadan kayıtlar.</p>
        </div>
        <a class="home-link" href="/haberler/">Tüm haberler</a>
      </div>

      <div class="news-list">
        {news.map((item) => (
          <a class="news-item" href={`/haberler/${item.slug}/`}>
            <p class="news-item__date">
              {formatDate(item.publishedAt)}
              <span>{item.category}</span>
            </p>
            <div>
              <h3>{item.title}</h3>
              <p class="news-item__excerpt">{item.excerpt}</p>
            </div>
            {item.cover && (
              <div class="news-item__thumb">
                <img
                  src={image800(item.cover)}
                  alt=""
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-cta">
    <div class="shell">
      <div class="home-cta__row">
        <div>
          <p class="eyebrow eyebrow--light">İletişim</p>
          <h2>Projeniz için görüşelim.</h2>
        </div>
        <div class="home-cta__actions">
          <a class="btn btn-white" href="/iletisim/">İletişime geçin</a>
          <a class="btn btn-light" href={`tel:${site.phoneHref}`}>{site.phone}</a>
        </div>
      </div>
      <div class="home-cta__foot">
        <span>
          {site.address.street}, {site.address.district} · {site.address.postalCode}{" "}
          {site.address.city} / {site.address.region}
        </span>
        <span>Ankara · Türkiye</span>
      </div>
    </div>
  </section>
</Base>
