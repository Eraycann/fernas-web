---
import Base from "../../layouts/Base.astro";
import bilgi from "../../data/bilgi-toplumu.json";

const updated = new Date(bilgi.modifiedAt).toLocaleDateString("tr-TR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---

<Base
  title="Bilgi Toplumu Hizmetleri — Fernas Şirketler Grubu"
  description="Fernas İnşaat A.Ş. şirket bilgileri, yönetim kurulu, denetçi ve kişisel verileri koruma belgeleri."
>
  <section class="section">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow">Kurumsal</p>
        <h1 class="mt-5 max-w-[14ch] font-display text-[clamp(2.8rem,5vw,5rem)] font-semibold leading-[0.86] tracking-[-0.06em]">
          Bilgi toplumu hizmetleri.
        </h1>
      </div>
      <div class="lg:col-span-5 lg:pt-16">
        <p class="section-lede">
          Şirket bilgileri, yönetim kurulu, denetçi ve kişisel verileri koruma
          belgeleri. Bilgiler, kaynak sitedeki kayıtlar esas alınarak
          yayımlanmıştır.
        </p>
        <p class="mono mt-6 text-[0.64rem] text-steel">Son güncelleme: {updated}</p>
      </div>
    </div>
  </section>

  <section class="section rule">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
      <aside class="lg:col-span-4">
        <div class="sticky top-24 border border-steel/30 p-5">
          <p class="mono text-[0.62rem] text-steel">İÇİNDEKİLER</p>
          <nav class="mt-4 flex flex-col" aria-label="Bilgi toplumu bölümleri">
            <a class="border-b border-steel/20 py-3 text-[0.88rem] hover:text-blue" href="#bolum-1">Şirket bilgileri</a>
            <a class="border-b border-steel/20 py-3 text-[0.88rem] hover:text-blue" href="#bolum-2">Yönetim kurulu</a>
            <a class="border-b border-steel/20 py-3 text-[0.88rem] hover:text-blue" href="#bolum-3">Denetçi</a>
            <a class="py-3 text-[0.88rem] hover:text-blue" href="#bolum-5">Kişisel verileri koruma</a>
          </nav>
        </div>

        <div class="mt-6 border border-steel/30 p-5">
          <p class="mono text-[0.62rem] text-steel">KVKK</p>
          <p class="mt-3 text-[0.84rem] leading-relaxed text-ink/60">
            Aydınlatma formu ve imha politikası bu sayfadan indirilebilir.
          </p>
        </div>
      </aside>

      <article class="prose-fernas lg:col-span-8" set:html={bilgi.html} />
    </div>
  </section>

  <section class="section bg-ink text-white">
    <div class="shell flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow text-white/75">İletişim</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(2rem,3.6vw,3.6rem)] font-semibold leading-[0.94] tracking-[-0.05em]">
          Bilgi talep edin.
        </h2>
      </div>
      <a class="btn btn-light" href="/iletisim/">İletişime geç</a>
    </div>
  </section>
</Base>
