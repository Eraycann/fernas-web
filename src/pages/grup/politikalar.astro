---
import Base from "../../layouts/Base.astro";
import policies from "../../data/policies.json";
---

<Base
  title="Politikalar — Fernas Şirketler Grubu"
  description="Fernas Şirketler Grubu politikaları: çevre, iş sağlığı ve güvenliği, kalite, uyum, insan hakları, iş etiği ve tedarik zinciri."
>
  <section class="section">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow">Kurumsal</p>
        <h1 class="mt-5 max-w-[13ch] font-display text-[clamp(2.8rem,5vw,5rem)] font-semibold leading-[0.86] tracking-[-0.06em]">
          Politikalar.
        </h1>
      </div>
      <div class="lg:col-span-5 lg:pt-16">
        <p class="section-lede">
          Grubun çevre, iş sağlığı ve güvenliği, kalite, uyum, insan hakları,
          iş etiği ve tedarik zinciri politikaları. Metinler PDF olarak
          yayımlanır.
        </p>
        <p class="mono mt-6 text-[0.64rem] text-steel">{policies.length} politika</p>
      </div>
    </div>
  </section>

  <section class="section rule">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <aside class="lg:col-span-4">
        <div class="sticky top-24 border border-steel/30 p-5">
          <p class="mono text-[0.62rem] text-steel">KAPSAM</p>
          <p class="mt-4 text-[0.9rem] leading-relaxed text-ink/65">
            Yönetişim, etik, insan hakları, çevre, iş sağlığı ve güvenliği,
            kalite ve tedarik zinciri.
          </p>
          <p class="mt-5 border-t border-steel/30 pt-4 text-[0.82rem] leading-relaxed text-ink/70">
            Bağlantılar yeni sekmede açılır. PDF dosyaları kurumsal politika
            metinlerinin yayımlandığı biçimdir.
          </p>
        </div>
      </aside>

      <div class="lg:col-span-8">
        <div class="border-t border-steel/30">
          {policies.map((policy) => (
            <a
              class="group grid grid-cols-[1fr_auto] items-start gap-4 border-b border-steel/30 py-6 transition-colors hover:bg-white sm:grid-cols-[1fr_7rem_auto] sm:items-center sm:gap-6"
              href={policy.file}
              target="_blank"
              rel="noopener"
            >
              <span>
                <span class="block font-display text-[1.15rem] font-semibold leading-[1.15] tracking-[-0.025em] group-hover:text-blue">
                  {policy.title}
                </span>
                {policy.code && (
                  <span class="mono mt-2 block text-[0.62rem] text-steel">{policy.code}</span>
                )}
              </span>
              <span class="mono hidden text-[0.62rem] text-steel sm:block">PDF</span>
              <span class="pt-0.5 text-blue transition-transform group-hover:translate-y-0.5" aria-hidden="true">
                ↓
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-ink text-white">
    <div class="shell flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow text-white/75">Uyum</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(2rem,3.6vw,3.6rem)] font-semibold leading-[0.94] tracking-[-0.05em]">
          Politikalar, günlük işin parçası.
        </h2>
      </div>
      <a class="btn btn-light" href="/iletisim/">İletişime geç</a>
    </div>
  </section>
</Base>
