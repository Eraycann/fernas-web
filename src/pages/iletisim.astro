---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/forms/ContactForm";
import site from "../data/site.json";
---

<Base
  title="İletişim"
  description="Fernas Şirketler Grubu merkez ofisi: Doğukent Bulvarı 495. Sokak No:2, Birlik Mahallesi, 06610 Çankaya/Ankara. Telefon: +90 312 454 16 00."
>
  <section class="section">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow">İletişim</p>
        <h1 class="mt-5 max-w-[12ch] font-display text-[clamp(2.8rem,5vw,5rem)] font-semibold leading-[0.86] tracking-[-0.06em]">
          Bize ulaşın.
        </h1>
      </div>
      <div class="lg:col-span-5 lg:pt-16">
        <p class="section-lede">
          Proje, tedarik, kariyer veya basın talepleriniz için formu kullanabilir
          ya da merkez ofisimizi arayabilirsiniz.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={`tel:${site.phoneHref}`}>{site.phone}</a>
          <a
            class="btn btn-ghost"
            href="https://maps.google.com/?q=Do%C4%9Fukent+Bulvar%C4%B1+495.+Sokak+No:2+%C3%87ankaya+Ankara"
            target="_blank"
            rel="noreferrer"
          >
            Haritada aç
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section rule">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 class="font-display text-[clamp(1.8rem,3vw,2.8rem)] font-semibold tracking-[-0.04em]">
          Mesaj bırakın.
        </h2>
        <p class="mt-4 max-w-xl text-[0.95rem] leading-relaxed text-ink/65">
          Formu doldurun; talebiniz ilgili birime yönlendirilsin. Yanıt süresi,
          talebin kapsamına göre değişebilir.
        </p>
        <div class="mt-8">
          <ContactForm client:load />
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="blueprint-grid border border-steel/30 p-6 sm:p-8">
          <p class="mono text-[0.62rem] text-steel">MERKEZ OFİS</p>
          <address class="mt-4 not-italic text-[1.05rem] leading-relaxed">
            {site.address.street}<br />
            {site.address.district}<br />
            {site.address.postalCode} {site.address.city} / {site.address.region}
          </address>

          <div class="mt-7 border-t border-steel/30 pt-5">
            <p class="mono text-[0.62rem] text-steel">TELEFON</p>
            <a class="mt-2 inline-block font-display text-[1.45rem] font-semibold tracking-[-0.03em] hover:text-blue" href={`tel:${site.phoneHref}`}>
              {site.phone}
            </a>
          </div>

          <div class="mt-7 border-t border-steel/30 pt-5">
            <p class="mono text-[0.62rem] text-steel">KARİYER</p>
            <a class="link-underline mt-2" href="/kariyer/">Açık pozisyonlar ve başvuru</a>
          </div>

          <div class="mt-7 border-t border-steel/30 pt-5">
            <p class="mono text-[0.62rem] text-steel">BASIN</p>
            <p class="mt-2 text-[0.9rem] leading-relaxed text-ink/65">
              Basın talepleri için formda “Basın ve iletişim” konusunu seçin.
            </p>
          </div>
        </div>

        <div class="mt-6 border border-steel/30 p-6">
          <p class="mono text-[0.62rem] text-steel">LOKASYON</p>
          <p class="mt-3 font-display text-[1.6rem] font-semibold tracking-[-0.03em]">Ankara · Türkiye</p>
          <p class="mt-2 text-[0.85rem] leading-relaxed text-ink/60">
            Çankaya, Birlik Mahallesi. Ziyaret öncesi randevu alınması önerilir.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>
