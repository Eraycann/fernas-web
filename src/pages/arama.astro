---
import Base from "../layouts/Base.astro";
---

<Base
  title="Arama"
  description="Fernas Şirketler Grubu sitesinde arama: projeler, haberler, sektörler ve kurumsal sayfalar."
  noindex
>
  <section class="section" data-pagefind-ignore>
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow">Arama</p>
          <h1 class="mt-5 max-w-[10ch] font-display text-[clamp(2.8rem,5vw,5rem)] font-semibold leading-[0.86] tracking-[-0.06em]">
            Sitede arama.
          </h1>
          <p class="section-lede mt-7">
            Projeler, haberler, sektörler ve kurumsal sayfalar arasında arayın.
          </p>
        </div>

        <div class="lg:col-span-7">
          <div id="search" class="min-h-40"></div>
          <noscript>
            <p class="mt-6 text-[0.9rem] leading-relaxed text-ink/65">
              Arama için JavaScript gerekir. Proje arşivine doğrudan
              <a class="text-blue underline underline-offset-2" href="/projeler/">buradan</a>
              ulaşabilirsiniz.
            </p>
          </noscript>
        </div>
      </div>
    </div>
  </section>

  <section class="section rule" data-pagefind-ignore>
    <div class="shell flex flex-wrap gap-x-8 gap-y-3">
      <a class="link-underline" href="/projeler/">Projeler</a>
      <a class="link-underline" href="/haberler/">Haberler</a>
      <a class="link-underline" href="/grup/politikalar/">Politikalar</a>
      <a class="link-underline" href="/iletisim/">İletişim</a>
    </div>
  </section>

  <script is:inline src="/pagefind/pagefind-ui.js" defer></script>
  <script is:inline>
    function initPagefind() {
      const target = document.querySelector("#search");
      if (!target) return;
      if (target.dataset.initialized === "true") return;

      if (typeof window.PagefindUI !== "function") {
        window.setTimeout(initPagefind, 80);
        return;
      }

      target.dataset.initialized = "true";
      new window.PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        translations: {
          placeholder: "Proje, haber veya sayfa ara",
          zero_results: "Sonuç bulunamadı",
          many_results: "[COUNT] sonuç",
          one_result: "[COUNT] sonuç",
          searching: "Aranıyor…",
        },
      });

      const query = new URLSearchParams(window.location.search).get("q");
      if (query) {
        const input = target.querySelector(".pagefind-ui__search-input");
        if (input) {
          input.value = query;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        }
      }
    }

    initPagefind();
  </script>
</Base>
